    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "The model",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The facts are measurements about data, not the data itself: rows and value at the source and in the warehouse, files and arrival times for each load, and records failing each rule.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#2A3A4D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "No status is stored. One measure compares every check with the thresholds on the rulebook, so changing a threshold changes every status in the report.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#2A3A4D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Three facts (Feed Run, Check Result, Issue), three dimensions (Date, Feed, Rule) and a Night table for trend axes. Issue is not related to Date, so the Load dropdown never hides an issue: its measures compare the dates opened and resolved with the night selected.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
