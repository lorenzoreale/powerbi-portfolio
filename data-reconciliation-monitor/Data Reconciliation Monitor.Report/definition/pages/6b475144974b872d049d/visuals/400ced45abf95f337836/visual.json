                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Ready: rows and value match the source, and every file arrived by 05:00.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
