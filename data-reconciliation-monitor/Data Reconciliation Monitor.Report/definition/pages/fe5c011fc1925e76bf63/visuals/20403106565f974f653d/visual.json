                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Load checks: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#E6EBF2"
                    }
                  },
                  {
                    "value": "rows and value against the source, and every file in by 05:00. Only these decide the status.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#C9D1DC"
                    }
