                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#E6EBF2"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Limits: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#E6EBF2"
                    }
                  },
                  {
                    "value": "any difference is a warning, over 0.5% of rows or 0.05% of value a failure. A late file is a warning, and a missing file or one over 60 minutes late is a failure.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#C9D1DC"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
