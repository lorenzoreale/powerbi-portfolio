                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#E6EBF2"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The status is worked out from the rulebook every time, so a limit changes in one place.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
