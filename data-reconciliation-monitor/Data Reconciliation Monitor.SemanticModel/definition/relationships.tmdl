relationship 'Feed Run to Date'
	fromColumn: 'Feed Run'.Date
	toColumn: Date.Date

relationship 'Feed Run to Feed'
	fromColumn: 'Feed Run'.'Feed Code'
	toColumn: Feed.'Feed Code'

relationship 'Check Result to Date'
	fromColumn: 'Check Result'.Date
	toColumn: Date.Date

relationship 'Check Result to Rule'
	fromColumn: 'Check Result'.'Rule Id'
	toColumn: Rule.'Rule Id'

relationship 'Check Result to Feed'
	fromColumn: 'Check Result'.'Feed Code'
	toColumn: Feed.'Feed Code'

relationship 'Issue to Feed'
	fromColumn: Issue.'Feed Code'
	toColumn: Feed.'Feed Code'
