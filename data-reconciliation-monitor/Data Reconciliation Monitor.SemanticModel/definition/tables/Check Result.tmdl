/// One row per rule per night it ran, latest run only: units checked, units failing and minutes late.
table 'Check Result'

	/// 2 failed, 1 warning, 0 passed, blank when nothing ran: the worst check in context, against the rulebook.
	measure 'Check Rank' =
			MAXX (
			    'Check Result',
			    VAR failRate = DIVIDE ( 'Check Result'[Failed], 'Check Result'[Checked] ) * 100
			    VAR minutesLate = 'Check Result'[Late Mins]
			    RETURN
			        IF (
			            RELATED ( Rule[Unit] ) = "files",
			            SWITCH (
			                TRUE (),
			                'Check Result'[Failed] > 0 || minutesLate > RELATED ( Rule[Fail Late Mins] ), 2,
			                minutesLate > RELATED ( Rule[Warn Late Mins] ), 1,
			                0
			            ),
			            SWITCH (
			                TRUE (),
			                failRate > RELATED ( Rule[Fail Above %] ), 2,
			                failRate > RELATED ( Rule[Warn Above %] ), 1,
			                0
			            )
			        )
			)
		formatString: 0
		isHidden
		displayFolder: Checks

	/// Passed, Warning or Failed.
	measure Result = SWITCH ( [Check Rank], 2, "Failed", 1, "Warning", 0, "Passed" )
		displayFolder: Checks

	measure 'Result Order' = [Check Rank] * 10 + MIN ( [Fail Rate], 1 )
		isHidden
		displayFolder: Checks
		formatStringDefinition = SWITCH ( [Check Rank], 2, """Failed""", 1, """Warning""", """Passed""" )

	/// Checks run: one per rule per night.
	measure 'Checks Run' = COUNTROWS ( 'Check Result' ) + 0
		formatString: #,0
		displayFolder: Checks

	measure 'Checks Passed' = COUNTROWS ( FILTER ( 'Check Result', [Check Rank] = 0 ) ) + 0
		formatString: #,0
		displayFolder: Checks

	measure 'Checks With Warning' = COUNTROWS ( FILTER ( 'Check Result', [Check Rank] = 1 ) ) + 0
		formatString: #,0
		displayFolder: Checks

	measure 'Checks Failed' = COUNTROWS ( FILTER ( 'Check Result', [Check Rank] = 2 ) ) + 0
		formatString: #,0
		displayFolder: Checks

	/// Checks with a warning or a failure.
	measure 'Checks Not Passed' = [Checks Run] - [Checks Passed]
		formatString: #,0
		displayFolder: Checks

	/// Units checked, in the rule's unit: rows, pounds or files.
	measure 'Units Checked' = SUM ( 'Check Result'[Checked] )
		formatString: #,0
		displayFolder: Checks

	/// Units failing the rule, in the rule's unit.
	measure 'Units Failed' = SUM ( 'Check Result'[Failed] )
		formatString: #,0
		displayFolder: Checks

	/// Units failing over units checked.
	measure 'Fail Rate' = DIVIDE ( [Units Failed], [Units Checked] )
		displayFolder: Checks
		formatStringDefinition = IF ( [Fail Rate] > 0 && [Fail Rate] < 0.0001, """<0.01%""", "0.00%" )

	/// Checks with a warning or a failure, as a share of checks run, over the 30 nights to the load selected.
	measure 'Share Not Passed 30 Nights' =
			VAR lastLoad = MAX ( 'Date'[Date] )
			RETURN
			    CALCULATE ( DIVIDE ( [Checks Not Passed], [Checks Run] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] > lastLoad - 30 && 'Date'[Date] <= lastLoad )
		formatString: 0.0%
		displayFolder: Trends

	/// Records failing a quality rule, night by night, over the 30 nights to the load selected. Load checks are left out.
	measure 'Records Failing by Night' =
			IF (
			    [In Last 30 Nights] = 1,
			    CALCULATE (
			        [Units Failed],
			        Rule[Is Load Check] = FALSE (),
			        Rule[Unit] = "rows",
			        REMOVEFILTERS ( 'Date' ),
			        TREATAS ( VALUES ( Night[Night] ), 'Date'[Date] )
			    )
			)
		formatString: #,0
		displayFolder: Trends

	measure 'Not Passed' = IF ( [Check Rank] >= 1, 1 )
		formatString: 0
		isHidden
		displayFolder: Checks

	measure 'Results Replaced by Rerun' = CALCULATE ( SUMX ( 'Check Result', 'Check Result'[Runs] - 1 ), REMOVEFILTERS ( 'Date' ) ) + 0
		formatString: #,0
		isHidden
		displayFolder: Data notes

	measure 'Colour Result Fill' = SWITCH ( [Check Rank], 2, "#4A2629", 1, "#45381D", 0, "#1E372B" )
		displayFolder: Colours

	measure 'Colour Result Text' = SWITCH ( [Check Rank], 2, "#F2A49F", 1, "#EDC679", 0, "#86C99D" )
		displayFolder: Colours

	measure 'Colour Dimension Bar' =
			VAR share = [Share Not Passed 30 Nights]
			VAR highest = MAXX ( ALLSELECTED ( Rule[Quality Dimension] ), [Share Not Passed 30 Nights] )
			RETURN
			    IF ( share = highest && share > 0, "#58B7D4", "#2C5A6B" )
		displayFolder: Colours

	column Date
		dataType: dateTime
		isHidden
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Rule Id'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Rule Id

	column 'Feed Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Feed Code

	/// Units checked, in the rule's unit.
	column Checked
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: Checked

	column Failed
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: Failed

	/// Minutes after 05:00, for the arrival checks only.
	column 'Late Mins'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Late Mins

	/// How many times the check was written for the night: 2 after a rerun.
	column Runs
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Runs

	partition 'Check Result' = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    CheckResult = Source{[Schema = "rpt", Item = "CheckResult"]}[Data]
				in
				    CheckResult

	annotation PBI_ResultType = Table
