/// One row per data area per night it was loaded: rows and value counted at the source and in the warehouse, files expected and received, and when the last file arrived. Measurements about the data, not the data itself. Nights with no load scheduled have no row.
table 'Feed Run'

	/// Rows in the source extract.
	measure 'Rows at Source' = SUM ( 'Feed Run'[Source Rows] )
		formatString: #,0
		displayFolder: Reconciliation

	/// Rows that landed in the warehouse.
	measure 'Rows in Warehouse' = SUM ( 'Feed Run'[Warehouse Rows] )
		formatString: #,0
		displayFolder: Reconciliation

	/// Warehouse minus source. Negative when rows are missing.
	measure 'Row Difference' = [Rows in Warehouse] - [Rows at Source]
		formatString: #,0;(#,0);0
		displayFolder: Reconciliation

	/// Source minus warehouse: the rows that did not land.
	measure 'Rows Missing' = [Rows at Source] - [Rows in Warehouse]
		formatString: #,0
		displayFolder: Reconciliation

	/// Share of rows that match the source: 1 minus the absolute differences over the rows at source, so an extra row counts against it as much as a missing one.
	measure 'Rows Matched %' =
			VAR rowsAtSource = [Rows at Source]
			RETURN
			    IF ( rowsAtSource > 0, 1 - DIVIDE ( SUMX ( 'Feed Run', ABS ( 'Feed Run'[Warehouse Rows] - 'Feed Run'[Source Rows] ) ), rowsAtSource ) )
		formatString: 0.00%
		displayFolder: Reconciliation

	/// The threshold for rows matched across all data areas, drawn as a dashed line.
	measure 'Rows Matched Threshold' = 0.999
		formatString: 0.00%
		displayFolder: Reconciliation

	/// Money in the source extract. Blank for the four data areas that carry no money.
	measure 'Value at Source' = SUM ( 'Feed Run'[Source Value] )
		formatString: £#,0
		displayFolder: Reconciliation

	/// Money that landed in the warehouse. Blank for the four data areas that carry no money.
	measure 'Value in Warehouse' = SUM ( 'Feed Run'[Warehouse Value] )
		formatString: £#,0
		displayFolder: Reconciliation

	/// Warehouse minus source, in pounds. Blank where there is no money to reconcile.
	measure 'Value Difference' = [Value in Warehouse] - [Value at Source]
		formatString: £#,0;(£#,0);£0
		displayFolder: Reconciliation

	/// Source minus warehouse, in pounds: the value that did not land.
	measure 'Value Missing' = [Value at Source] - [Value in Warehouse]
		formatString: £#,0
		displayFolder: Reconciliation

	/// Files expected for the load.
	measure 'Files Due' = SUM ( 'Feed Run'[Files Expected] )
		formatString: 0
		displayFolder: Reconciliation

	/// Files received for the load.
	measure 'Files Arrived' = SUM ( 'Feed Run'[Files Received] )
		formatString: 0
		displayFolder: Reconciliation

	/// Files expected that never arrived.
	measure 'Files Missing' = [Files Due] - [Files Arrived]
		formatString: 0
		displayFolder: Reconciliation

	/// Files received out of files expected, for example "2 of 3".
	measure 'Files Arrived Text' = IF ( NOT ISBLANK ( [Files Due] ), [Files Arrived] & " of " & [Files Due] )
		displayFolder: Reconciliation

	/// When the last file of the load arrived.
	measure 'Arrived At' = MAX ( 'Feed Run'[Arrival Time] )
		formatString: hh:mm
		displayFolder: Reconciliation

	/// Minutes between the 05:00 deadline and the arrival of the last file. Negative when early.
	measure 'Minutes After Deadline' =
			VAR arrived = [Arrived At]
			RETURN
			    IF ( NOT ISBLANK ( arrived ), ROUND ( ( arrived - TIME ( 5, 0, 0 ) ) * 1440, 0 ) )
		formatString: +0;-0;0
		displayFolder: Reconciliation

	/// Rows matched on the night on the axis, for the 30 nights up to the load selected.
	measure 'Rows Matched % by Night' =
			IF ( [In Last 30 Nights] = 1, CALCULATE ( [Rows Matched %], TREATAS ( VALUES ( Night[Night] ), 'Date'[Date] ) ) )
		formatString: 0.00%
		displayFolder: Trends

	/// Rows missing on the night on the axis, for the 30 nights up to the load selected. Blank on nights with no load.
	measure 'Rows Missing by Night' =
			IF ( [In Last 30 Nights] = 1, CALCULATE ( [Rows Missing], TREATAS ( VALUES ( Night[Night] ), 'Date'[Date] ) ) )
		formatString: #,0
		displayFolder: Trends

	/// Subtitle under the report name: the load selected.
	measure 'Header Subtitle' = "Overnight load of " & FORMAT ( MAX ( 'Date'[Date] ), "dddd d mmmm yyyy" )
		displayFolder: Report text

	/// Context line under rows missing on the data area page.
	measure 'Context Rows' =
			IF ( ISBLANK ( [Rows at Source] ), "No load that night", "of " & FORMAT ( [Rows at Source], "#,0" ) & " " & SELECTEDVALUE ( Feed[Record Name] ) & " at the source" )
		displayFolder: Report text

	/// Context line under value missing on the data area page.
	measure 'Context Value' =
			IF ( ISBLANK ( [Value at Source] ), "No money in this data area", "of £" & FORMAT ( [Value at Source], "#,0" ) & " at the source" )
		displayFolder: Report text

	/// Context line under the arrival time on the data area page.
	measure 'Context Arrival' = IF ( NOT ISBLANK ( [Files Due] ), [Files Arrived] & " of " & [Files Due] & " files · deadline 05:00" )
		displayFolder: Report text

	/// First line of the Reconciliation page.
	measure 'Headline Reconciliation' =
			FORMAT ( [Rows at Source], "#,0" ) & " rows and £" & FORMAT ( [Value at Source] / 1000000, "0.0" ) & "m compared for the load of "
			    & FORMAT ( MAX ( 'Date'[Date] ), "d mmmm" ) & ": " & FORMAT ( [Rows Matched %], "0.00%" ) & " of rows matched."
		displayFolder: Report text

	/// Second line of the Reconciliation page: every data area that is short, largest value first.
	measure 'Headline Reconciliation Follow-up' =
			VAR short =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( Feed[Data Area] ), "@Rows", [Rows Missing], "@Value", [Value Missing] ),
			        [@Rows] > 0 || [@Value] > 0
			    )
			RETURN
			    IF (
			        ISEMPTY ( short ),
			        "Every data area matches its source, in rows and in value.",
			        CONCATENATEX (
			            short,
			            Feed[Data Area] & ": " & IF ( [@Rows] > 0, FORMAT ( [@Rows], "#,0" ) & " rows" ) & IF ( [@Rows] > 0 && [@Value] > 0, " and " )
			                & IF ( [@Value] > 0, "£" & FORMAT ( [@Value], "#,0" ) ) & " short",
			            ". ",
			            [@Value], DESC
			        ) & "."
			    )
		displayFolder: Report text

	/// Title of the rows-matched trend: the lowest night in the window.
	measure 'Title Match Trend' =
			VAR lastLoad = MAX ( 'Date'[Date] )
			VAR nights =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Date'[Date] ), 'Date'[Date] > lastLoad - 30 && 'Date'[Date] <= lastLoad ),
			        "@Matched", [Rows Matched %]
			    )
			VAR lowest = TOPN ( 1, nights, [@Matched], ASC, 'Date'[Date], DESC )
			RETURN
			    "Rows matched, last 30 nights: lowest " & FORMAT ( MAXX ( lowest, [@Matched] ), "0.00%" ) & " on " & FORMAT ( MAXX ( lowest, 'Date'[Date] ), "d mmmm" )
		displayFolder: Report text

	/// Title of the arrival chart: the latest data area, or that every load beat the deadline.
	measure 'Title Arrival' =
			VAR areas = ADDCOLUMNS ( VALUES ( Feed[Data Area] ), "@Minutes", [Minutes After Deadline] )
			VAR latest = TOPN ( 1, areas, [@Minutes], DESC, Feed[Data Area], ASC )
			VAR minutes = MAXX ( latest, [@Minutes] )
			RETURN
			    IF (
			        minutes > 0,
			        MAXX ( latest, Feed[Data Area] ) & " landed " & minutes & " minutes after the 05:00 deadline",
			        "Every data area landed before the 05:00 deadline"
			    )
		displayFolder: Report text

	/// Red when rows or value are missing.
	measure 'Colour Difference' = IF ( [Rows Missing] > 0 || [Value Missing] > 0, "#B23A2E", "#1D2A36" )
		displayFolder: Colours

	/// Arrival bars: red when a file is missing or the load is over an hour late, amber when late, otherwise the data colour.
	measure 'Colour Arrival Bar' =
			VAR minutes = [Minutes After Deadline]
			RETURN
			    SWITCH ( TRUE (), [Files Missing] > 0 || minutes > 60, "#B23A2E", minutes > 0, "#D39B2A", "#1B8DB0" )
		displayFolder: Colours

	column Date
		dataType: dateTime
		isHidden
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Feed Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Feed Code

	column 'Source Rows'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: Source Rows

	column 'Warehouse Rows'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: Warehouse Rows

	/// Blank, not zero, for data areas with no money.
	column 'Source Value'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: Source Value

	column 'Warehouse Value'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: Warehouse Value

	column 'Files Expected'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Files Expected

	column 'Files Received'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Files Received

	/// When the last file arrived, cleaned to hours and minutes.
	column 'Arrival Time'
		dataType: dateTime
		isHidden
		formatString: hh:mm
		summarizeBy: none
		sourceColumn: Arrival Time

		annotation UnderlyingDateTimeDataType = Time

	partition 'Feed Run' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\feed_run.csv"), [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Arrival Time to HH:MM" = Table.TransformColumns(#"Promoted Headers", {{"arrival_time", each Text.PadStart(Text.Start(_, Text.PositionOf(_, ":") + 3), 5, "0"), type text}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Arrival Time to HH:MM", {{"date", "Date"}, {"feed_code", "Feed Code"}, {"source_rows", "Source Rows"}, {"warehouse_rows", "Warehouse Rows"}, {"source_value", "Source Value"}, {"warehouse_value", "Warehouse Value"}, {"files_expected", "Files Expected"}, {"files_received", "Files Received"}, {"arrival_time", "Arrival Time"}}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Renamed Columns", {{"Date", type date}, {"Feed Code", type text}, {"Source Rows", Int64.Type}, {"Warehouse Rows", Int64.Type}, {"Source Value", Int64.Type}, {"Warehouse Value", Int64.Type}, {"Files Expected", Int64.Type}, {"Files Received", Int64.Type}, {"Arrival Time", type time}})
				in
				    #"Changed Types"

