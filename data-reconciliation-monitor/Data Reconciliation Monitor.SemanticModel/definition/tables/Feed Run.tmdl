/// One row per data area per night it loaded: rows and value at the source and in the warehouse, files and arrival.
table 'Feed Run'

	/// Rows the source system sent.
	measure 'Rows at Source' = SUM ( 'Feed Run'[Source Rows] )
		formatString: #,0
		displayFolder: Load

	/// Rows that landed in the warehouse.
	measure 'Rows in Warehouse' = SUM ( 'Feed Run'[Warehouse Rows] )
		formatString: #,0
		displayFolder: Load

	/// Rows at the source that did not land in the warehouse.
	measure 'Rows Missing' = [Rows at Source] - [Rows in Warehouse]
		formatString: #,0
		displayFolder: Load

	/// Warehouse rows that match the source, as a share of the rows at the source.
	measure 'Rows Matched %' =
			VAR rowsAtSource = [Rows at Source]
			RETURN
			    IF ( rowsAtSource > 0, 1 - DIVIDE ( SUMX ( 'Feed Run', ABS ( 'Feed Run'[Source Rows] - 'Feed Run'[Warehouse Rows] ) ), rowsAtSource ) )
		displayFolder: Load
		formatStringDefinition = IF ( [Rows Matched %] < 1 && [Rows Matched %] >= 0.99995, """>99.99%""", "0.00%" )

	/// Value the source sent. Blank for the areas that carry no money.
	measure 'Value at Source' = SUM ( 'Feed Run'[Source Value] )
		formatString: £#,0
		displayFolder: Load

	/// Value that landed in the warehouse. Blank for the areas that carry no money.
	measure 'Value in Warehouse' = SUM ( 'Feed Run'[Warehouse Value] )
		formatString: £#,0
		displayFolder: Load

	/// Value at the source that did not land in the warehouse.
	measure 'Value Missing' = [Value at Source] - [Value in Warehouse]
		formatString: £#,0
		displayFolder: Load

	measure 'Files Due' = SUM ( 'Feed Run'[Files Expected] )
		formatString: 0
		displayFolder: Load

	measure 'Files Arrived' = SUM ( 'Feed Run'[Files Received] )
		formatString: 0
		displayFolder: Load

	/// Files expected that night that did not arrive.
	measure 'Files Missing' = [Files Due] - [Files Arrived]
		formatString: 0
		displayFolder: Load

	measure 'Files Text' = IF ( NOT ISBLANK ( [Files Due] ), [Files Arrived] & " of " & [Files Due] )
		displayFolder: Load

	/// When the last file of the load arrived.
	measure 'Arrived At' = MAX ( 'Feed Run'[Arrival Time] )
		formatString: hh:mm
		displayFolder: Load

	/// Minutes between the 05:00 deadline and the arrival: negative when early.
	measure 'Minutes After Deadline' =
			VAR arrived = [Arrived At]
			RETURN
			    IF ( NOT ISBLANK ( arrived ), ROUND ( ( arrived - TIME ( 5, 0, 0 ) ) * 1440, 0 ) )
		formatString: +0;-0;0
		displayFolder: Load

	/// Minutes after the 05:00 deadline, zero when on time.
	measure 'Minutes Late' =
			VAR minutes = [Minutes After Deadline]
			RETURN
			    IF ( NOT ISBLANK ( minutes ), MAX ( minutes, 0 ) )
		formatString: 0
		displayFolder: Load

	measure 'KPI Last File Context' =
			VAR minutes = [Minutes After Deadline]
			VAR lastArea = TOPN ( 1, VALUES ( Feed[Data Area] ), [Arrived At], DESC, Feed[Data Area], ASC )
			RETURN
			    IF (
			        NOT ISBLANK ( minutes ),
			        MAXX ( lastArea, Feed[Data Area] ) & " · " & IF ( minutes > 0, minutes & " min after 05:00", "before the 05:00 deadline" )
			    )
		displayFolder: KPI

	measure 'KPI Rows Context' = IF ( ISBLANK ( [Rows at Source] ), "No load that night", "of " & FORMAT ( [Rows at Source], "#,0", "en-GB" ) & " " & SELECTEDVALUE ( Feed[Record Name] ) & " at the source" )
		displayFolder: KPI

	measure 'KPI Value Context' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Rows at Source] ), "No load that night",
			    ISBLANK ( [Value at Source] ), "No money in this data area",
			    "of £" & FORMAT ( [Value at Source], "#,0", "en-GB" ) & " at the source"
			)
		displayFolder: KPI

	measure 'KPI Files Context' = IF ( NOT ISBLANK ( [Files Due] ), "Due by 05:00 · " & SELECTEDVALUE ( Feed[Schedule] ) )
		displayFolder: KPI

	measure 'KPI Arrival Context' =
			VAR minutes = [Minutes After Deadline]
			RETURN
			    IF ( NOT ISBLANK ( minutes ), IF ( minutes > 0, minutes & " min after the 05:00 deadline", -minutes & " min before the 05:00 deadline" ) )
		displayFolder: KPI

	measure 'Rows Matched Limit' = 1 - CALCULATE ( MAX ( Rule[Fail Above %] ), REMOVEFILTERS ( Rule ), Rule[Is Load Check] = TRUE (), Rule[Unit] = "rows" ) / 100
		formatString: 0.0%
		isHidden
		displayFolder: Trends

	/// Rows matched for the area furthest from its source, night by night, over the 30 nights to the load selected.
	measure 'Lowest Rows Matched by Night' =
			IF (
			    [In Last 30 Nights] = 1,
			    CALCULATE (
			        MINX ( VALUES ( Feed[Feed Code] ), [Rows Matched %] ),
			        REMOVEFILTERS ( 'Date' ),
			        TREATAS ( VALUES ( Night[Night] ), 'Date'[Date] )
			    )
			)
		formatString: 0.0%
		displayFolder: Trends

	measure 'Lowest Rows Matched Under Limit' =
			VAR matched = [Lowest Rows Matched by Night]
			RETURN
			    IF ( matched < [Rows Matched Limit], matched )
		formatString: 0.0%
		displayFolder: Trends

	/// Rows missing from the warehouse, night by night, over the 30 nights to the load selected.
	measure 'Rows Missing by Night' =
			IF (
			    [In Last 30 Nights] = 1,
			    CALCULATE ( [Rows Missing], REMOVEFILTERS ( 'Date' ), TREATAS ( VALUES ( Night[Night] ), 'Date'[Date] ) )
			)
		formatString: #,0
		displayFolder: Trends

	measure 'Colour Rows Missing by Night' =
			VAR checkRank =
			    CALCULATE (
			        [Check Rank],
			        REMOVEFILTERS ( Rule ),
			        Rule[Is Load Check] = TRUE (),
			        Rule[Unit] = "rows",
			        REMOVEFILTERS ( 'Date' ),
			        TREATAS ( VALUES ( Night[Night] ), 'Date'[Date] )
			    )
			RETURN
			    SWITCH ( checkRank, 2, "#D65F5F", 1, "#D9A03F", "#58B7D4" )
		displayFolder: Colours

	measure 'Colour Rows Missing' =
			SWITCH ( CALCULATE ( [Check Rank], REMOVEFILTERS ( Rule ), Rule[Is Load Check] = TRUE (), Rule[Unit] = "rows" ), 2, "#EE8A84", 1, "#E8BA62", "#E6EBF2" )
		displayFolder: Colours

	measure 'Colour Value Missing' =
			SWITCH ( CALCULATE ( [Check Rank], REMOVEFILTERS ( Rule ), Rule[Is Load Check] = TRUE (), Rule[Unit] = "pounds" ), 2, "#EE8A84", 1, "#E8BA62", "#E6EBF2" )
		displayFolder: Colours

	measure 'Colour Arrival' =
			SWITCH ( CALCULATE ( [Check Rank], REMOVEFILTERS ( Rule ), Rule[Unit] = "files" ), 2, "#EE8A84", 1, "#E8BA62", "#E6EBF2" )
		displayFolder: Colours

	measure 'Colour Arrival Bar' =
			SWITCH ( CALCULATE ( [Check Rank], REMOVEFILTERS ( Rule ), Rule[Unit] = "files" ), 2, "#D65F5F", 1, "#D9A03F", "#58B7D4" )
		displayFolder: Colours

	measure 'Colour Last File' =
			VAR minutes = [Minutes After Deadline]
			RETURN
			    SWITCH ( TRUE (), minutes > 60, "#EE8A84", minutes > 0, "#E8BA62", "#E6EBF2" )
		displayFolder: Colours

	measure 'Arrival Times Reformatted' = CALCULATE ( COUNTROWS ( 'Feed Run' ), 'Feed Run'[Arrival Reformatted] = TRUE (), REMOVEFILTERS ( 'Date' ) ) + 0
		formatString: #,0
		isHidden
		displayFolder: Data notes

	measure 'Nights With No Load' =
			CALCULATE (
			    COUNTROWS ( CROSSJOIN ( VALUES ( 'Date'[Date] ), VALUES ( Feed[Feed Code] ) ) ) - COUNTROWS ( 'Feed Run' ),
			    REMOVEFILTERS ( 'Date' )
			)
		formatString: #,0
		isHidden
		displayFolder: Data notes

	measure 'Loads With No Value' = CALCULATE ( COUNTROWS ( FILTER ( 'Feed Run', ISBLANK ( 'Feed Run'[Source Value] ) ) ), REMOVEFILTERS ( 'Date' ) ) + 0
		formatString: #,0
		isHidden
		displayFolder: Data notes

	column Date
		dataType: dateTime
		isHidden
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Feed Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Feed Code

	column 'Source Rows'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Source Rows

	column 'Warehouse Rows'
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Warehouse Rows

	column 'Source Value'
		dataType: decimal
		isHidden
		formatString: £#,0
		summarizeBy: sum
		sourceColumn: Source Value

	column 'Warehouse Value'
		dataType: decimal
		isHidden
		formatString: £#,0
		summarizeBy: sum
		sourceColumn: Warehouse Value

	column 'Files Expected'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: sum
		sourceColumn: Files Expected

	column 'Files Received'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: sum
		sourceColumn: Files Received

	/// Arrival of the last file, to the minute.
	column 'Arrival Time'
		dataType: dateTime
		isHidden
		formatString: hh:mm
		summarizeBy: none
		sourceColumn: Arrival Time

		annotation UnderlyingDateTimeDataType = Time

	/// True when the source wrote the arrival time in another format.
	column 'Arrival Reformatted'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Arrival Reformatted

	partition 'Feed Run' = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    FeedRun = Source{[Schema = "rpt", Item = "FeedRun"]}[Data]
				in
				    FeedRun

	annotation PBI_ResultType = Table
