/// The nights on the axis of the trend visuals, not related to the facts, so a trend can show the nights before the load selected.
table Night

	measure 'In Last 14 Nights' =
			VAR lastLoad = MAX ( 'Date'[Date] )
			VAR night = MAX ( Night[Night] )
			RETURN
			    IF ( night > lastLoad - 14 && night <= lastLoad, 1 )
		formatString: 0
		isHidden
		displayFolder: Windows

	measure 'In Last 30 Nights' =
			VAR lastLoad = MAX ( 'Date'[Date] )
			VAR night = MAX ( Night[Night] )
			RETURN
			    IF ( night > lastLoad - 30 && night <= lastLoad, 1 )
		formatString: 0
		isHidden
		displayFolder: Windows

	column Night
		dataType: dateTime
		isKey
		formatString: d mmm
		summarizeBy: none
		sourceColumn: Night

		annotation UnderlyingDateTimeDataType = Date

	/// The day of the month, for the narrow columns of the 14-night grid.
	column 'Night Label'
		dataType: string
		summarizeBy: none
		sourceColumn: Night Label
		sortByColumn: Night

	partition Night = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Night = Source{[Schema = "rpt", Item = "Night"]}[Data],
				    #"Kept Night Columns" = Table.SelectColumns(Night, {"Date", "Night Label"}),
				    #"Renamed Date" = Table.RenameColumns(#"Kept Night Columns", {{"Date", "Night"}})
				in
				    #"Renamed Date"

	annotation PBI_ResultType = Table
