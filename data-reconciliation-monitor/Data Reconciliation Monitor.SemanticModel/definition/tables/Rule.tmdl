/// The rulebook: one row per check, with the limits that decide warning and failure.
table Rule

	column 'Rule Id'
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: Rule Id

	column 'Feed Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Feed Code

	column Rule
		dataType: string
		summarizeBy: none
		sourceColumn: Rule

	/// Completeness, Consistency, Timeliness, Uniqueness or Validity.
	column 'Quality Dimension'
		dataType: string
		summarizeBy: none
		sourceColumn: Quality Dimension

	/// What the rule counts: rows, pounds or files.
	column Unit
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Unit

	/// True for the checks against the source and the deadline, the only ones that decide the status.
	column 'Is Load Check'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Is Load Check

	column 'Check Type'
		dataType: string
		summarizeBy: none
		sourceColumn: Check Type

	column 'Warn Above %'
		dataType: decimal
		isHidden
		formatString: 0.00
		summarizeBy: none
		sourceColumn: Warn Above %

	column 'Fail Above %'
		dataType: decimal
		isHidden
		formatString: 0.00
		summarizeBy: none
		sourceColumn: Fail Above %

	column 'Warn Late Mins'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Warn Late Mins

	column 'Fail Late Mins'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Fail Late Mins

	/// The limits of the rule in words.
	column Limit
		dataType: string
		summarizeBy: none
		sourceColumn: Limit

	/// The first night the rule ran, for rules added during the window.
	column 'Active From'
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: Active From

		annotation UnderlyingDateTimeDataType = Date

	/// What one failing record is, for the quality rules.
	column 'Failing Record'
		dataType: string
		summarizeBy: none
		sourceColumn: Failing Record

	partition Rule = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Rule = Source{[Schema = "rpt", Item = "Rule"]}[Data]
				in
				    Rule

	annotation PBI_ResultType = Table
