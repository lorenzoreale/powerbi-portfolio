/// One row per issue in the ticketing tool export. The measures read it as it stood on the night selected.
table Issue

	/// Issues open on the morning of the load selected: opened by then and not yet resolved.
	measure 'Open Issues' =
			VAR night = MAX ( 'Date'[Date] )
			RETURN
			    COUNTROWS ( FILTER ( Issue, Issue[Opened] <= night && ( ISBLANK ( Issue[Resolved] ) || Issue[Resolved] > night ) ) ) + 0
		formatString: 0
		displayFolder: Issues

	/// Open issues logged as critical.
	measure 'Critical Open' = CALCULATE ( [Open Issues], Issue[Severity] = "Critical" )
		formatString: 0
		displayFolder: Issues

	/// Issues open four weeks before the load selected.
	measure 'Open Four Weeks Earlier' =
			VAR night = MAX ( 'Date'[Date] ) - 28
			RETURN
			    COUNTROWS ( FILTER ( Issue, Issue[Opened] <= night && ( ISBLANK ( Issue[Resolved] ) || Issue[Resolved] > night ) ) ) + 0
		formatString: 0
		displayFolder: Issues

	/// Days an open issue has been open on the night selected, or the oldest when several are in context.
	measure 'Days Open' =
			VAR night = MAX ( 'Date'[Date] )
			RETURN
			    MAXX ( FILTER ( Issue, Issue[Opened] <= night && ( ISBLANK ( Issue[Resolved] ) || Issue[Resolved] > night ) ), INT ( night - Issue[Opened] ) )
		formatString: 0
		displayFolder: Issues

	/// Issues opened in the 7 nights to the load selected.
	measure 'Opened Last 7 Nights' =
			VAR night = MAX ( 'Date'[Date] )
			RETURN
			    COUNTROWS ( FILTER ( Issue, Issue[Opened] > night - 7 && Issue[Opened] <= night ) ) + 0
		formatString: 0
		displayFolder: Issues

	/// Issues resolved in the 7 nights to the load selected.
	measure 'Resolved Last 7 Nights' =
			VAR night = MAX ( 'Date'[Date] )
			RETURN
			    COUNTROWS ( FILTER ( Issue, Issue[Resolved] > night - 7 && Issue[Resolved] <= night && Issue[Resolved] >= Issue[Opened] ) ) + 0
		formatString: 0
		displayFolder: Issues

	/// Average days from opened to resolved, for issues resolved in the 28 nights to the load selected.
	measure 'Days to Resolve' =
			VAR night = MAX ( 'Date'[Date] )
			RETURN
			    AVERAGEX (
			        FILTER ( Issue, Issue[Resolved] > night - 28 && Issue[Resolved] <= night && Issue[Resolved] >= Issue[Opened] ),
			        INT ( Issue[Resolved] - Issue[Opened] )
			    )
		formatString: 0.0
		displayFolder: Issues

	measure 'Resolved Last 28 Nights' =
			VAR night = MAX ( 'Date'[Date] )
			RETURN
			    COUNTROWS ( FILTER ( Issue, Issue[Resolved] > night - 28 && Issue[Resolved] <= night && Issue[Resolved] >= Issue[Opened] ) ) + 0
		formatString: 0
		isHidden
		displayFolder: Issues

	/// The target for Days to Resolve.
	measure 'Days to Resolve Target' = 3
		formatString: 0
		displayFolder: Issues

	measure 'Open 0 to 2 Days' =
			VAR night = MAX ( 'Date'[Date] )
			RETURN
			    COUNTROWS ( FILTER ( Issue, Issue[Opened] <= night && Issue[Opened] > night - 3 && ( ISBLANK ( Issue[Resolved] ) || Issue[Resolved] > night ) ) ) + 0
		formatString: 0
		displayFolder: Age bands

	measure 'Open 3 to 6 Days' =
			VAR night = MAX ( 'Date'[Date] )
			RETURN
			    COUNTROWS ( FILTER ( Issue, Issue[Opened] <= night - 3 && Issue[Opened] > night - 7 && ( ISBLANK ( Issue[Resolved] ) || Issue[Resolved] > night ) ) ) + 0
		formatString: 0
		displayFolder: Age bands

	measure 'Open 7 Days or More' =
			VAR night = MAX ( 'Date'[Date] )
			RETURN
			    COUNTROWS ( FILTER ( Issue, Issue[Opened] <= night - 7 && ( ISBLANK ( Issue[Resolved] ) || Issue[Resolved] > night ) ) ) + 0
		formatString: 0
		displayFolder: Age bands

	measure 'Is Open' = IF ( [Open Issues] > 0, 1 )
		formatString: 0
		isHidden
		displayFolder: Issues

	/// Issues opened, night by night, over the 30 nights to the load selected.
	measure 'Opened by Night' =
			VAR night = MAX ( Night[Night] )
			RETURN
			    IF ( [In Last 30 Nights] = 1, COUNTROWS ( FILTER ( Issue, Issue[Opened] = night ) ) + 0 )
		formatString: 0
		displayFolder: Trends

	/// Issues resolved, night by night, over the 30 nights to the load selected.
	measure 'Resolved by Night' =
			VAR night = MAX ( Night[Night] )
			RETURN
			    IF ( [In Last 30 Nights] = 1, COUNTROWS ( FILTER ( Issue, Issue[Resolved] = night && Issue[Resolved] >= Issue[Opened] ) ) + 0 )
		formatString: 0
		displayFolder: Trends

	/// Issues open on each night, over the 30 nights to the load selected.
	measure 'Open Issues by Night' =
			IF (
			    [In Last 30 Nights] = 1,
			    CALCULATE ( [Open Issues], REMOVEFILTERS ( 'Date' ), TREATAS ( VALUES ( Night[Night] ), 'Date'[Date] ) )
			)
		formatString: 0
		displayFolder: Trends

	measure 'Issues Out of Order' = COUNTROWS ( FILTER ( Issue, Issue[Resolved Before Opened] ) ) + 0
		formatString: 0
		isHidden
		displayFolder: Data notes

	measure 'KPI Open Context' = [Critical Open] & " critical · " & [Open Four Weeks Earlier] & " open four weeks earlier"
		displayFolder: KPI

	measure 'KPI Critical Context' = "High " & CALCULATE ( [Open Issues], Issue[Severity] = "High" ) & " · medium " & CALCULATE ( [Open Issues], Issue[Severity] = "Medium" ) & " · low " & CALCULATE ( [Open Issues], Issue[Severity] = "Low" )
		displayFolder: KPI

	measure 'KPI Oldest Context' =
			VAR night = MAX ( 'Date'[Date] )
			VAR oldest = TOPN ( 1, FILTER ( Issue, Issue[Opened] <= night && ( ISBLANK ( Issue[Resolved] ) || Issue[Resolved] > night ) ), Issue[Opened], ASC, Issue[Issue Id], ASC )
			RETURN
			    IF ( NOT ISEMPTY ( oldest ), MAXX ( oldest, Issue[Issue Id] ) & " · " & MAXX ( oldest, RELATED ( Feed[Data Area] ) ) )
		displayFolder: KPI

	measure 'KPI Resolve Context' = "Target " & [Days to Resolve Target] & " days · " & [Resolved Last 28 Nights] & " resolved in 28 nights"
		displayFolder: KPI

	measure 'Colour Critical' = IF ( [Critical Open] > 0, "#EE8A84", "#E6EBF2" )
		displayFolder: Colours

	measure 'Colour Critical Accent' = IF ( [Critical Open] > 0, "#D65F5F", "#58B7D4" )
		displayFolder: Colours

	measure 'Colour Days to Resolve' = IF ( [Days to Resolve] > [Days to Resolve Target], "#EE8A84", "#E6EBF2" )
		displayFolder: Colours

	measure 'Colour Severity Fill' = SWITCH ( SELECTEDVALUE ( Issue[Severity] ), "Critical", "#4A2629", "High", "#45381D", "#252C35" )
		displayFolder: Colours

	measure 'Colour Severity Text' = SWITCH ( SELECTEDVALUE ( Issue[Severity] ), "Critical", "#F2A49F", "High", "#EDC679", "#B9C2CE" )
		displayFolder: Colours

	measure 'Colour Old Issues' = IF ( [Open 7 Days or More] > 0, "#E8BA62", "#E6EBF2" )
		displayFolder: Colours

	column 'Issue Id'
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: Issue Id

	column Opened
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: Opened

		annotation UnderlyingDateTimeDataType = Date

	/// Blank while the issue is open.
	column Resolved
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: Resolved

		annotation UnderlyingDateTimeDataType = Date

	column 'Feed Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Feed Code

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column Severity
		dataType: string
		summarizeBy: none
		sourceColumn: Severity
		sortByColumn: 'Severity Order'

	column 'Severity Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Severity Order

	column Owner
		dataType: string
		summarizeBy: none
		sourceColumn: Owner

	/// The latest note on the issue in the ticketing tool.
	column 'Where It Stands'
		dataType: string
		summarizeBy: none
		sourceColumn: Where It Stands

	/// True for an issue closed on a date before it was opened: counted, but left out of the averages.
	column 'Resolved Before Opened'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Resolved Before Opened

	partition Issue = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Issue Log Folder" & "\issue_log.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Types" = Table.TransformColumnTypes(#"Promoted Headers", {{"issue_id", type text}, {"opened", type date}, {"resolved", type date}, {"feed_code", type text}, {"category", type text}, {"severity", type text}, {"owner", type text}, {"status", type text}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Types", {{"issue_id", "Issue Id"}, {"opened", "Opened"}, {"resolved", "Resolved"}, {"feed_code", "Feed Code"}, {"category", "Category"}, {"severity", "Severity"}, {"owner", "Owner"}, {"status", "Where It Stands"}}),
				    #"Added Severity Order" = Table.AddColumn(#"Renamed Columns", "Severity Order", each List.PositionOf({"Critical", "High", "Medium", "Low"}, [Severity]) + 1, Int64.Type),
				    #"Flagged Resolved Before Opened" = Table.AddColumn(#"Added Severity Order", "Resolved Before Opened", each [Resolved] <> null and [Resolved] < [Opened], type logical)
				in
				    #"Flagged Resolved Before Opened"

	annotation PBI_ResultType = Table
