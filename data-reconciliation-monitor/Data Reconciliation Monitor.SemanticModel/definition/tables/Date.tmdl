/// One row per night in the window. The Load selector filters this table.
table Date
	dataCategory: Time

	measure 'Header Subtitle' = "Load of " & FORMAT ( MAX ( 'Date'[Date] ), "ddd d mmm yyyy", "en-GB" ) & " · " & COUNTROWS ( ALL ( Feed ) ) & " data areas · deadline 05:00"
		displayFolder: Report text

	column Date
		dataType: dateTime
		isKey
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	/// The night of the load, latest first in the selector.
	column Load
		dataType: string
		summarizeBy: none
		sourceColumn: Load
		sortByColumn: 'Nights Back'

	column 'Nights Back'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Nights Back

	partition Date = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Night = Source{[Schema = "rpt", Item = "Night"]}[Data],
				    #"Removed Night Label" = Table.RemoveColumns(Night, {"Night Label"})
				in
				    #"Removed Night Label"

	annotation PBI_ResultType = Table
