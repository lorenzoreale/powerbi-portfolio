/// One row per overnight load, 1 April to 29 June 2026, marked as the date table. The Load dropdown on every page filters it, so a plain measure gives the figure for the load selected.
table Date
	dataCategory: Time

	/// The night of the load. Shown in the Load dropdown.
	column Date
		dataType: dateTime
		isKey
		formatString: ddd d mmm yyyy
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Weekday
		dataType: string
		summarizeBy: none
		sourceColumn: Weekday

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month

	partition Date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\date.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {{"date", "Date"}, {"weekday", "Weekday"}, {"month", "Month"}}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Renamed Columns", {{"Date", type date}, {"Weekday", type text}, {"Month", type text}})
				in
				    #"Changed Types"

