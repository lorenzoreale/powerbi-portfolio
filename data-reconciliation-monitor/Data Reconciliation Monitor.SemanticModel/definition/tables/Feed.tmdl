/// One row per data area: a nightly load from a source system, the reports it feeds and who owns it.
table Feed

	/// 2 not ready, 1 use with care, 0 ready, -1 no load that night. Only the load checks count.
	measure 'Status Rank' = COALESCE ( CALCULATE ( [Check Rank], REMOVEFILTERS ( Rule ), Rule[Is Load Check] = TRUE () ), -1 )
		formatString: 0
		isHidden
		displayFolder: Status

	/// Ready, Use with care, Not ready, or No load when none was scheduled that night.
	measure Status = SWITCH ( [Status Rank], 2, "Not ready", 1, "Use with care", 0, "Ready", "No load" )
		displayFolder: Status

	measure 'Board Status' = [Status Rank] * 100 - MAX ( Feed[Sort Order] )
		isHidden
		displayFolder: Status
		formatStringDefinition = SWITCH ( [Status Rank], 2, """Not ready"";""Not ready"";""Not ready""", 1, """Use with care"";""Use with care"";""Use with care""", 0, """Ready"";""Ready"";""Ready""", """No load"";""No load"";""No load""" )

	/// Data areas whose figures can be used that morning: every status except Not ready.
	measure 'Areas Usable' = COUNTROWS ( FILTER ( Feed, [Status Rank] <> 2 ) ) + 0
		formatString: 0
		displayFolder: Status

	/// Data areas whose rows and value match the source and whose files all arrived by 05:00.
	measure 'Areas Ready' = COUNTROWS ( FILTER ( Feed, [Status Rank] = 0 ) ) + 0
		formatString: 0
		displayFolder: Status

	/// Data areas with a difference inside tolerance or a late file.
	measure 'Areas With Care' = COUNTROWS ( FILTER ( Feed, [Status Rank] = 1 ) ) + 0
		formatString: 0
		displayFolder: Status

	/// Data areas not ready: the reports they feed wait for a reload.
	measure 'Areas Not Ready' = COUNTROWS ( FILTER ( Feed, [Status Rank] = 2 ) ) + 0
		formatString: 0
		displayFolder: Status

	measure 'Areas No Load' = COUNTROWS ( FILTER ( Feed, [Status Rank] = -1 ) ) + 0
		formatString: 0
		isHidden
		displayFolder: Status

	measure 'Data Areas' = COUNTROWS ( Feed ) + 0
		formatString: 0
		isHidden
		displayFolder: Status

	/// The night of one area in short facts: files missing, rows and value short, arrival, quality rules flagged.
	measure 'Last Night Facts' =
			VAR statusRank = [Status Rank]
			VAR records = SELECTEDVALUE ( Feed[Record Name] )
			VAR rowsMissing = [Rows Missing]
			VAR valueMissing = [Value Missing]
			VAR filesMissing = [Files Missing]
			VAR minutesLate = [Minutes Late]
			VAR warehouseValue = [Value in Warehouse]
			VAR flagged = CALCULATE ( [Checks Not Passed], REMOVEFILTERS ( Rule ), Rule[Is Load Check] = FALSE () )
			VAR facts =
			    IF ( filesMissing > 0, " · " & filesMissing & " of " & [Files Due] & " files missing" )
			        & IF ( rowsMissing > 0, " · " & FORMAT ( rowsMissing, "#,0", "en-GB" ) & " " & IF ( rowsMissing = 1, LEFT ( records, LEN ( records ) - 1 ), records ) & " short" )
			        & IF ( valueMissing > 0, " · £" & FORMAT ( valueMissing, "#,0", "en-GB" ) & " short" )
			        & IF ( minutesLate > 0, " · " & minutesLate & " min late", " · in at " & FORMAT ( [Arrived At], "hh:mm", "en-GB" ) )
			        & IF ( flagged > 0, " · " & flagged & IF ( flagged = 1, " quality rule flagged", " quality rules flagged" ) )
			RETURN
			    SWITCH (
			        statusRank,
			        -1, "No load on " & FORMAT ( MAX ( 'Date'[Date] ), "dddd", "en-GB" ) & "s",
			        0,
			            FORMAT ( [Rows in Warehouse], "#,0", "en-GB" ) & " " & records
			                & IF ( NOT ISBLANK ( warehouseValue ), " · £" & FORMAT ( warehouseValue / 1000000, "0.00", "en-GB" ) & "m" ) & facts,
			        MID ( facts, 4, 500 )
			    )
		displayFolder: Status

	measure 'Status on Night' =
			IF (
			    [In Last 14 Nights] = 1,
			    CALCULATE ( [Status Rank], REMOVEFILTERS ( 'Date' ), TREATAS ( VALUES ( Night[Night] ), 'Date'[Date] ) )
			)
		formatString: 0
		isHidden
		displayFolder: Grid

	measure 'Grid Symbol' = SWITCH ( [Status on Night], 2, "✕", 1, "!", 0, "✓", -1, "–" )
		displayFolder: Grid

	measure 'KPI Usable Context' =
			VAR care = [Areas With Care]
			VAR noLoad = [Areas No Load]
			RETURN
			    "of " & [Data Areas] & " · " & [Areas Ready] & " ready" & IF ( care > 0, " · " & care & " with care" ) & IF ( noLoad > 0, " · " & noLoad & " no load" )
		displayFolder: KPI

	measure 'KPI Not Ready Context' =
			VAR notReady = FILTER ( Feed, [Status Rank] = 2 )
			RETURN
			    IF ( ISEMPTY ( notReady ), "Nothing to hold back", CONCATENATEX ( notReady, Feed[Data Area], ", ", Feed[Sort Order], ASC ) )
		displayFolder: KPI

	measure 'Drill Title' = SELECTEDVALUE ( Feed[Data Area] )
		displayFolder: Report text

	measure 'Drill Subtitle' =
			SELECTEDVALUE ( Feed[Source System] ) & " · feeds " & LOWER ( SELECTEDVALUE ( Feed[Feeds Into] ) ) & " · " & SELECTEDVALUE ( Feed[Schedule] )
			    & " · owner " & SELECTEDVALUE ( Feed[Owner] )
		displayFolder: Report text

	measure 'Colour Not Ready' = IF ( [Areas Not Ready] > 0, "#EE8A84", "#E6EBF2" )
		displayFolder: Colours

	measure 'Colour Not Ready Accent' = IF ( [Areas Not Ready] > 0, "#D65F5F", "#58B7D4" )
		displayFolder: Colours

	measure 'Colour Status Fill' = SWITCH ( [Status Rank], 2, "#4A2629", 1, "#45381D", 0, "#1E372B", "#252C35" )
		displayFolder: Colours

	measure 'Colour Status Text' = SWITCH ( [Status Rank], 2, "#F2A49F", 1, "#EDC679", 0, "#86C99D", "#8A96A6" )
		displayFolder: Colours

	measure 'Colour Grid Fill' = SWITCH ( [Status on Night], 2, "#D65F5F", 1, "#D9A03F", 0, "#1E372B", -1, "#1C222B" )
		displayFolder: Colours

	measure 'Colour Grid Symbol' = SWITCH ( [Status on Night], 2, "#14181F", 1, "#14181F", 0, "#6FBF8B", -1, "#5C6B78" )
		displayFolder: Colours

	column 'Feed Code'
		dataType: string
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: Feed Code

	/// The business name of the data area, in the order the business reads them.
	column 'Data Area'
		dataType: string
		summarizeBy: none
		sourceColumn: Data Area
		sortByColumn: 'Sort Order'

	/// The technical name of the load, as the data team knows it.
	column Feed
		dataType: string
		summarizeBy: none
		sourceColumn: Feed

	column 'Source System'
		dataType: string
		summarizeBy: none
		sourceColumn: Source System

	/// The reports that depend on the data area.
	column 'Feeds Into'
		dataType: string
		summarizeBy: none
		sourceColumn: Feeds Into

	/// What one row is, in the plural: transactions, orders, invoices.
	column 'Record Name'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Record Name

	column Schedule
		dataType: string
		summarizeBy: none
		sourceColumn: Schedule

	column Owner
		dataType: string
		summarizeBy: none
		sourceColumn: Owner

	/// False for the four areas that carry no money to reconcile.
	column 'Has Value'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Has Value

	column 'Files Expected'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Files Expected

	column 'Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Sort Order

	partition Feed = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Feed = Source{[Schema = "rpt", Item = "Feed"]}[Data]
				in
				    Feed

	annotation PBI_ResultType = Table
