model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Server","Database","Issue Log Folder","Feed","Rule","Date","Night","Feed Run","Check Result","Issue"]

ref table 'Feed Run'
ref table 'Check Result'
ref table Issue
ref table Feed
ref table Rule
ref table Date
ref table Night
ref table 'Data Note'
