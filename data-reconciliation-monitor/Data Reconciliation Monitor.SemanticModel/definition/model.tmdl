model 'Data Reconciliation Monitor'
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Date","Feed","Rule","Feed Run","Check Result","Break","Run Date","Data Folder"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Feed
ref table Rule
ref table 'Feed Run'
ref table 'Check Result'
ref table Break
ref table 'Run Date'

