/// Folder holding the exports and the reference files.
expression 'Data Folder' = "C:\powerbi_portfolio\site-inspection-performance\data" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	annotation PBI_ResultType = Text

expression 'Read Export' =
		(file as binary) as table =>
		let
		    Source = Csv.Document(file, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true])
		in
		    #"Promoted Headers"

	annotation PBI_ResultType = Function

expression 'Export Rows' =
		let
		    Source = Folder.Files(#"Data Folder" & "\exports"),
		    #"Filtered Inspection Files" = Table.SelectRows(Source, each Text.StartsWith([Name], "inspections_") and [Extension] = ".csv"),
		    #"Added Rows" = Table.AddColumn(#"Filtered Inspection Files", "Rows", each #"Read Export"([Content])),
		    #"Removed Other Columns" = Table.SelectColumns(#"Added Rows", {"Name", "Rows"}),
		    #"Expanded Rows" = Table.ExpandTableColumn(#"Removed Other Columns", "Rows", Table.ColumnNames(#"Removed Other Columns"{0}[Rows])),
		    #"Added Date Format" = Table.AddColumn(#"Expanded Rows", "Date Format", each if Text.Contains([submitted_at], "/") then "dd/mm/yyyy" else "yyyy-mm-dd", type text),
		    #"Changed Type" = Table.TransformColumnTypes(#"Added Date Format", {{"submitted_at", type datetime}, {"last_modified", type datetime}, {"site_id", Int64.Type}}, "en-GB")
		in
		    #"Changed Type"

	annotation PBI_ResultType = Table

expression 'Latest Export Rows' =
		let
		    Source = #"Export Rows",
		    #"Sorted Latest First" = Table.Sort(Source, {{"last_modified", Order.Descending}}),
		    Buffered = Table.Buffer(#"Sorted Latest First"),
		    #"Removed Re-exported Rows" = Table.Distinct(Buffered, {"inspection_id"})
		in
		    #"Removed Re-exported Rows"

	annotation PBI_ResultType = Table
