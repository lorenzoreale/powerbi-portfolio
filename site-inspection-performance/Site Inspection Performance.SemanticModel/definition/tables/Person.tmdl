/// Inspectors and site managers, plus an Unassigned member for actions recorded without an owner.
table Person
	lineageTag: c82da659-3898-4348-b08e-c81c4ae42e4f

	column PersonKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 90a09837-2579-480f-a2eb-90efdc392188
		summarizeBy: none
		sourceColumn: PersonKey

	column 'Person Name'
		dataType: string
		lineageTag: 1b32b304-d518-4df5-bc7d-7a02c52a9143
		summarizeBy: none
		sourceColumn: Person Name

	/// Inspector, Site manager or Unassigned.
	column Role
		dataType: string
		lineageTag: 1ec4a358-1bf1-4b56-9998-4da10e89c9d2
		summarizeBy: none
		sourceColumn: Role

	partition Person = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\people.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Removed Home Region" = Table.RemoveColumns(#"Promoted Headers", {"home_region"}),
				    #"Added Unassigned" = Table.InsertRows(#"Removed Home Region", 0, {[person_id = "0", person_name = "Unassigned", role = "Unassigned"]}),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Unassigned", {{"person_id", "PersonKey"}, {"person_name", "Person Name"}, {"role", "Role"}}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Renamed Columns", {{"PersonKey", Int64.Type}, {"Person Name", type text}, {"Role", type text}})
				in
				    #"Changed Types"

