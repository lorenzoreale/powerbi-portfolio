/// The 24-question inspection checklist, in six sections.
table Checklist

	column 'Question Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Question Code

	column Section
		dataType: string
		summarizeBy: none
		sourceColumn: Section
		sortByColumn: 'Section Order'

	column 'Section Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Section Order

	column 'Question Text'
		dataType: string
		summarizeBy: none
		sourceColumn: Question Text
		sortByColumn: 'Checklist Order'

	column 'Checklist Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Checklist Order

	partition Checklist = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\checklist.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"checklist_order", Int64.Type}}),
				    Sections = List.Distinct(#"Changed Type"[section]),
				    #"Added Section Order" = Table.AddColumn(#"Changed Type", "Section Order", each List.PositionOf(Sections, [section]) + 1, Int64.Type),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Section Order", {{"question_code", "Question Code"}, {"section", "Section"}, {"question_text", "Question Text"}, {"checklist_order", "Checklist Order"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table
