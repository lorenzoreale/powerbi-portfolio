/// What-if parameter for the Visits page: the longest gap allowed between two visits, 15 to 90 days.
table 'Visit Rule'

	/// The visit rule being tested on the Visits page. 60 days, the agreed rule, everywhere else.
	measure 'Visit Rule Value' = SELECTEDVALUE ( 'Visit Rule'[Visit Rule], 60 )
		formatString: 0
		displayFolder: Visits

	column 'Visit Rule'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Value]

		extendedProperty ParameterMetadata =
				{
				  "version": 0
				}

	partition 'Visit Rule' = calculated
		mode: import
		source = GENERATESERIES ( 15, 90, 5 )
