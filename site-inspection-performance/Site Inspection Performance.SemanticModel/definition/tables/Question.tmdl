/// The 24-question inspection checklist, four questions in each of six sections.
table Question
	lineageTag: 18877acb-e3ef-44ce-b4ae-45b173ea2300

	column QuestionKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ffa8de21-5102-42f0-bb27-0c030b96ab3d
		summarizeBy: none
		sourceColumn: QuestionKey

	column 'Question Code'
		dataType: string
		lineageTag: 08dcd307-4c82-4b2d-8d7f-afc466115fb9
		summarizeBy: none
		sourceColumn: Question Code

	/// Checklist section, sorted in checklist order.
	column Section
		dataType: string
		lineageTag: f4a1b634-d3ee-4f63-9342-9e668973539a
		summarizeBy: none
		sourceColumn: Section
		sortByColumn: 'Section Order'

	column 'Section Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2510b5a0-10ab-4b7f-939b-b260f3d41281
		summarizeBy: none
		sourceColumn: Section Order

	column Question
		dataType: string
		lineageTag: c301f5de-2b9c-4aa5-98e0-d2b341832262
		summarizeBy: none
		sourceColumn: Question

	partition Question = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\questions.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {{"question_id", "QuestionKey"}, {"question_code", "Question Code"}, {"section", "Section"}, {"question_text", "Question"}}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Renamed Columns", {{"QuestionKey", Int64.Type}, {"Question Code", type text}, {"Section", type text}, {"Question", type text}}),
				    #"Added Section Order" = Table.AddColumn(#"Changed Types", "Section Order", each Number.IntegerDivide([QuestionKey] - 1, 4) + 1, Int64.Type)
				in
				    #"Added Section Order"

