/// One row per answer: inspection x checklist question.
table Response

	/// Answers marked Pass or Fail. N/A answers do not count.
	measure 'Questions Applicable' = CALCULATE ( COUNTROWS ( 'Response' ), 'Response'[Result] IN { "Pass", "Fail" } )
		formatString: #,0
		displayFolder: Compliance

	/// Answers marked Pass.
	measure 'Questions Passed' = CALCULATE ( COUNTROWS ( 'Response' ), 'Response'[Result] = "Pass" )
		formatString: #,0
		displayFolder: Compliance

	/// Questions passed / questions applicable. Blank when nothing was inspected.
	measure 'Compliance %' = DIVIDE ( [Questions Passed], [Questions Applicable] )
		formatString: 0.0%
		displayFolder: Compliance

	/// Compliance over the same days a year earlier, up to the as-at date.
	measure 'Compliance % Last Year' =
			VAR sameDayLastYear = EDATE ( [As-at Date], -12 )
			RETURN
			    CALCULATE ( [Compliance %], SAMEPERIODLASTYEAR ( 'Date'[Date] ), 'Date'[Date] <= sameDayLastYear )
		formatString: 0.0%
		displayFolder: Compliance

	/// The compliance target for the estate.
	measure 'Compliance Target' = 0.9
		formatString: 0%
		displayFolder: Compliance

	/// Failed answers.
	measure Findings = CALCULATE ( COUNTROWS ( 'Response' ), 'Response'[Result] = "Fail" )
		formatString: #,0
		displayFolder: Compliance

	/// Failed answers per inspection.
	measure 'Findings per Inspection' = DIVIDE ( [Findings], [Inspections] )
		formatString: 0.0
		displayFolder: Compliance

	/// Failed answers per inspection over the same days a year earlier.
	measure 'Findings per Inspection Last Year' =
			VAR sameDayLastYear = EDATE ( [As-at Date], -12 )
			RETURN
			    CALCULATE ( [Findings per Inspection], SAMEPERIODLASTYEAR ( 'Date'[Date] ), 'Date'[Date] <= sameDayLastYear )
		formatString: 0.0
		displayFolder: Compliance

	/// Sites inspected in the period whose compliance is below the target.
	measure 'Sites Below Target' =
			VAR target = [Compliance Target]
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( 'Site'[Site ID] ), VAR c = [Compliance %] RETURN NOT ISBLANK ( c ) && c < target ) ) + 0
		formatString: #,0
		displayFolder: Compliance

	/// The checklist section with the lowest compliance in the period.
	measure 'Weakest Section' =
			VAR bySection = ADDCOLUMNS ( VALUES ( 'Checklist'[Section] ), "@Compliance", [Compliance %] )
			VAR lowest = MINX ( bySection, [@Compliance] )
			RETURN
			    MAXX ( FILTER ( bySection, [@Compliance] = lowest ), 'Checklist'[Section] )
		displayFolder: Compliance

	measure 'Context Compliance' = "Target " & FORMAT ( [Compliance Target], "0%" ) & " · last year " & FORMAT ( [Compliance % Last Year], "0.0%" )
		displayFolder: Labels

	measure 'Question Rank' =
			VAR findings = [Findings]
			VAR position = SELECTEDVALUE ( 'Checklist'[Checklist Order] )
			RETURN
			    IF (
			        NOT ISBLANK ( findings ) && NOT ISBLANK ( position ),
			        COUNTROWS (
			            FILTER (
			                ADDCOLUMNS ( ALLSELECTED ( 'Checklist'[Question Text], 'Checklist'[Checklist Order] ), "@Findings", [Findings] ),
			                [@Findings] > findings || ( [@Findings] = findings && 'Checklist'[Checklist Order] < position )
			            )
			        ) + 1
			    )
		formatString: 0
		displayFolder: Helpers

	measure 'Site Compliance Rank' =
			VAR compliance = [Compliance %]
			VAR siteName = SELECTEDVALUE ( 'Site'[Site Name] )
			RETURN
			    IF (
			        NOT ISBLANK ( compliance ) && NOT ISBLANK ( siteName ),
			        COUNTROWS (
			            FILTER (
			                ADDCOLUMNS ( ALLSELECTED ( 'Site'[Site Name] ), "@Compliance", [Compliance %] ),
			                NOT ISBLANK ( [@Compliance] ) && ( [@Compliance] < compliance || ( [@Compliance] = compliance && 'Site'[Site Name] < siteName ) )
			            )
			        ) + 1
			    )
		formatString: 0
		displayFolder: Helpers

	measure 'Context Sites Below Target' =
			VAR inspected = COUNTROWS ( FILTER ( VALUES ( 'Site'[Site ID] ), NOT ISBLANK ( [Inspections] ) ) )
			RETURN
			    "of " & inspected & " sites inspected in the year"
		displayFolder: Labels

	measure 'Context Weakest Section' =
			VAR bySection = ADDCOLUMNS ( VALUES ( 'Checklist'[Section] ), "@Compliance", [Compliance %] )
			RETURN
			    FORMAT ( MINX ( bySection, [@Compliance] ), "0.0%" ) & " compliance · target " & FORMAT ( [Compliance Target], "0%" )
		displayFolder: Labels

	measure 'Context Findings' = "Last year " & FORMAT ( [Findings per Inspection Last Year], "0.0" )
		displayFolder: Labels

	measure 'Context Site Compliance' =
			VAR region = SELECTEDVALUE ( 'Site'[Region] )
			VAR regionRate = CALCULATE ( [Compliance %], REMOVEFILTERS ( 'Site' ), 'Site'[Region] = region )
			VAR allSites = CALCULATE ( [Compliance %], REMOVEFILTERS ( 'Site' ) )
			RETURN
			    region & " " & FORMAT ( regionRate, "0.0%" ) & " · all sites " & FORMAT ( allSites, "0.0%" )
		displayFolder: Labels

	measure 'Colour Compliance' =
			VAR gap = [Compliance %] - [Compliance Target]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( [Compliance %] ), BLANK (), gap >= 0, "#24589E", gap >= -0.02, "#D9922F", "#C2453A" )
		displayFolder: Colours

	measure 'Colour Compliance Value' = IF ( [Compliance %] < [Compliance Target], "#C2453A", "#16324F" )
		displayFolder: Colours

	measure 'Colour Latest Score Value' = IF ( [Latest Score] < [Compliance Target], "#C2453A", "#16324F" )
		displayFolder: Colours

	measure 'Colour Compliance Cell' =
			VAR compliance = [Compliance %]
			VAR target = [Compliance Target]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( compliance ), BLANK (),
			        compliance >= target, BLANK (),
			        compliance >= target - 0.02, "#F7E1DE",
			        compliance >= target - 0.05, "#EFC2BC",
			        "#E39A91"
			    )
		displayFolder: Colours

	column 'Inspection ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Inspection ID

	column 'Question Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Question Code

	column Result
		dataType: string
		summarizeBy: none
		sourceColumn: Result

	column Severity
		dataType: string
		summarizeBy: none
		sourceColumn: Severity
		sortByColumn: 'Severity Order'

	column 'Severity Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Severity Order

	partition Response = m
		mode: import
		source =
				let
				    Source = #"Latest Export Rows",
				    #"Removed Columns" = Table.RemoveColumns(Source, {"Name", "Date Format", "submitted_at", "last_modified", "site_id", "site_name", "inspector", "comments"}),
				    #"Unpivoted Questions" = Table.UnpivotOtherColumns(#"Removed Columns", {"inspection_id"}, "Question Code", "Answer"),
				    #"Added Result" = Table.AddColumn(#"Unpivoted Questions", "Result", each if Text.StartsWith([Answer], "Fail") then "Fail" else [Answer], type text),
				    #"Added Severity" = Table.AddColumn(#"Added Result", "Severity", each if [Result] = "Fail" then Text.AfterDelimiter([Answer], " - ") else null, type text),
				    #"Added Severity Order" = Table.AddColumn(#"Added Severity", "Severity Order", each if [Severity] = "High" then 1 else if [Severity] = "Medium" then 2 else if [Severity] = "Low" then 3 else null, Int64.Type),
				    #"Removed Answer" = Table.RemoveColumns(#"Added Severity Order", {"Answer"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Answer", {{"inspection_id", "Inspection ID"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table
