/// One row per site, from the site register.
table Site

	/// Days from the last visit to the as-at date. For a group of sites, the longest gap.
	measure 'Days Since Last Visit' =
			VAR asAt = [As-at Date]
			RETURN
			    MAXX (
			        VALUES ( 'Site'[Site ID] ),
			        VAR lastVisit = CALCULATE ( MAX ( 'Inspection'[Inspection Date] ), REMOVEFILTERS ( 'Date' ) )
			        RETURN
			            IF ( NOT ISBLANK ( lastVisit ), DATEDIFF ( lastVisit, asAt, DAY ) )
			    )
		formatString: #,0
		displayFolder: Visits

	/// Sites whose last visit is further back than the visit rule.
	measure 'Sites Past Visit Rule' =
			VAR rule = [Visit Rule Value]
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( 'Site'[Site ID] ), [Days Since Last Visit] > rule ) ) + 0
		formatString: #,0
		displayFolder: Visits

	/// The fewest visits a month that would see every site in view within the visit rule.
	measure 'Visits Needed per Month' = ROUNDUP ( DIVIDE ( COUNTROWS ( 'Site' ) * 365 / 12, [Visit Rule Value] ), 0 )
		formatString: #,0
		displayFolder: Visits

	/// Inspections a month in the period, counting only the days up to the as-at date.
	measure 'Visits Made per Month' =
			VAR firstDay = MIN ( 'Date'[Date] )
			VAR lastDay = MIN ( MAX ( 'Date'[Date] ), [As-at Date] )
			RETURN
			    DIVIDE ( [Inspections], ( lastDay - firstDay + 1 ) * 12 / 365 )
		formatString: #,0
		displayFolder: Visits

	/// Visits each site needs in the period to stay within the visit rule.
	measure 'Visits Needed per Site' =
			VAR firstDay = MIN ( 'Date'[Date] )
			VAR lastDay = MIN ( MAX ( 'Date'[Date] ), [As-at Date] )
			RETURN
			    DIVIDE ( lastDay - firstDay + 1, [Visit Rule Value] )
		formatString: 0.0
		displayFolder: Visits

	measure 'Context Sites Past Rule' =
			VAR rule = [Visit Rule Value]
			VAR gaps = ADDCOLUMNS ( VALUES ( 'Site'[Site Name] ), "@Gap", [Days Since Last Visit] )
			VAR longest = MAXX ( gaps, [@Gap] )
			VAR siteName = MAXX ( TOPN ( 1, gaps, [@Gap], DESC, 'Site'[Site Name], ASC ), 'Site'[Site Name] )
			RETURN
			    IF ( longest > rule, "Longest: " & siteName & ", " & longest & " days", "Every site visited within " & rule & " days" )
		displayFolder: Labels

	measure 'Visit Gap Rank' =
			VAR gap = [Days Since Last Visit]
			VAR siteName = SELECTEDVALUE ( 'Site'[Site Name] )
			RETURN
			    IF (
			        NOT ISBLANK ( gap ) && NOT ISBLANK ( siteName ),
			        COUNTROWS (
			            FILTER (
			                ADDCOLUMNS ( ALLSELECTED ( 'Site'[Site Name] ), "@Gap", [Days Since Last Visit] ),
			                [@Gap] > gap || ( [@Gap] = gap && 'Site'[Site Name] < siteName )
			            )
			        ) + 1
			    )
		formatString: 0
		displayFolder: Helpers

	measure 'Most Visited Rank' =
			VAR visits = [Inspections] + 0
			VAR siteName = SELECTEDVALUE ( 'Site'[Site Name] )
			RETURN
			    IF (
			        NOT ISBLANK ( siteName ),
			        COUNTROWS (
			            FILTER (
			                ADDCOLUMNS ( ALLSELECTED ( 'Site'[Site Name] ), "@Visits", [Inspections] + 0 ),
			                [@Visits] > visits || ( [@Visits] = visits && 'Site'[Site Name] < siteName )
			            )
			        ) + 1
			    )
		formatString: 0
		displayFolder: Helpers

	measure 'Context Visit Rule' = "Rule: a visit at least every " & [Visit Rule Value] & " days"
		displayFolder: Labels

	measure 'Context Visits Needed' = "To see all " & COUNTROWS ( 'Site' ) & " sites within " & [Visit Rule Value] & " days"
		displayFolder: Labels

	measure 'Context Visits Made' = FORMAT ( [Inspections] + 0, "#,0" ) & " inspections in the year selected"
		displayFolder: Labels

	measure 'Colour Sites Past Rule' = IF ( [Sites Past Visit Rule] > 0, "#C2453A", "#16324F" )
		displayFolder: Colours

	measure 'Site Title' = SELECTEDVALUE ( 'Site'[Site Name] )
		displayFolder: Labels

	measure 'Site Subtitle' =
			SELECTEDVALUE ( 'Site'[Region] ) & " · " & SELECTEDVALUE ( 'Site'[Site Type] ) & " · "
			    & FORMAT ( CALCULATE ( [Inspections], REMOVEFILTERS ( 'Date' ) ), "#,0" ) & " inspections in the data"
		displayFolder: Labels

	measure 'Colour Visit Gap' =
			VAR gap = [Days Since Last Visit]
			VAR rule = [Visit Rule Value]
			RETURN
			    SWITCH ( TRUE (), gap > rule, "#C2453A", gap > rule - 7, "#D9922F", "#AEC7E6" )
		displayFolder: Colours

	column 'Site ID'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Site ID

	column 'Site Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Site Name

	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: Region

	column 'Site Type'
		dataType: string
		summarizeBy: none
		sourceColumn: Site Type

	partition Site = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\sites.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"site_id", Int64.Type}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type", {{"site_id", "Site ID"}, {"site_name", "Site Name"}, {"region", "Region"}, {"site_type", "Site Type"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table
