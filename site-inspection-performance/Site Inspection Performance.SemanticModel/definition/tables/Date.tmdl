/// One row per day, from the first year of inspections to the year of the last due date.
table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Key'

	column 'Month Key'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Key

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: Month Start

		annotation UnderlyingDateTimeDataType = Date

	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: 'Month Number'

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Number

	/// True up to the as-at date. Keeps the trend charts from running into empty months.
	column 'In Data'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: In Data

	partition Date = m
		mode: import
		source =
				let
				    AsAt = List.Max(Inspection[Inspection Date]),
				    FirstDay = #date(Date.Year(List.Min(Inspection[Inspection Date])), 1, 1),
				    LastDay = #date(Date.Year(List.Max(Action[Due Date])), 12, 31),
				    Dates = List.Dates(FirstDay, Duration.Days(LastDay - FirstDay) + 1, #duration(1, 0, 0, 0)),
				    #"Converted to Table" = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Converted to Table", {{"Date", type date}}),
				    #"Added Year" = Table.AddColumn(#"Changed Type", "Year", each Date.Year([Date]), Int64.Type),
				    #"Added Month" = Table.AddColumn(#"Added Year", "Month", each Date.ToText([Date], "MMM yyyy", "en-GB"), type text),
				    #"Added Month Key" = Table.AddColumn(#"Added Month", "Month Key", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    #"Added Month Start" = Table.AddColumn(#"Added Month Key", "Month Start", each Date.StartOfMonth([Date]), type date),
				    #"Added Month Name" = Table.AddColumn(#"Added Month Start", "Month Name", each Date.ToText([Date], "MMM", "en-GB"), type text),
				    #"Added Month Number" = Table.AddColumn(#"Added Month Name", "Month Number", each Date.Month([Date]), Int64.Type),
				    #"Added In Data" = Table.AddColumn(#"Added Month Number", "In Data", each [Date] <= AsAt, type logical)
				in
				    #"Added In Data"

	annotation PBI_ResultType = Table
