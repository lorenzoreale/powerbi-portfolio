/// One row per corrective action, from the actions list.
table Action

	/// Actions due in the period, up to the as-at date, each judged in the month it fell due.
	measure 'Actions Due' =
			VAR asAt = [As-at Date]
			RETURN
			    CALCULATE ( COUNTROWS ( 'Action' ), 'Action'[Due Date] <= asAt )
		formatString: #,0
		displayFolder: Actions

	/// Actions due in the period that were closed on or before their due date.
	measure 'Actions Closed On Time' = CALCULATE ( [Actions Due], 'Action'[Closed On Time] = TRUE () )
		formatString: #,0
		displayFolder: Actions

	/// Actions closed on time / actions due.
	measure 'On-time Closure %' = DIVIDE ( [Actions Closed On Time], [Actions Due] )
		formatString: 0.0%
		displayFolder: Actions

	/// On-time closure over the same days a year earlier.
	measure 'On-time Closure % Last Year' =
			VAR sameDayLastYear = EDATE ( [As-at Date], -12 )
			RETURN
			    CALCULATE ( [On-time Closure %], SAMEPERIODLASTYEAR ( 'Date'[Date] ), 'Date'[Date] <= sameDayLastYear )
		formatString: 0.0%
		displayFolder: Actions

	/// The on-time closure target.
	measure 'On-time Target' = 0.9
		formatString: 0%
		displayFolder: Actions

	/// Actions not closed, as at the as-at date, whatever the period selected.
	measure 'Open Actions' = CALCULATE ( COUNTROWS ( 'Action' ), ISBLANK ( 'Action'[Closed Date] ), REMOVEFILTERS ( 'Date' ) ) + 0
		formatString: #,0
		displayFolder: Actions

	/// Open actions past their due date, as at the as-at date.
	measure 'Overdue Actions' =
			VAR asAt = [As-at Date]
			RETURN
			    CALCULATE ( [Open Actions], 'Action'[Due Date] < asAt )
		formatString: #,0
		displayFolder: Actions

	/// Overdue actions with no owner recorded.
	measure 'Overdue Unassigned' = CALCULATE ( [Overdue Actions], 'Action'[Owner] = "Unassigned" )
		formatString: #,0
		displayFolder: Actions

	/// Days past due of the oldest overdue action.
	measure 'Oldest Overdue Days' = CALCULATE ( MAX ( 'Action'[Days Overdue] ), REMOVEFILTERS ( 'Date' ) )
		formatString: #,0
		displayFolder: Actions

	/// Actions whose site name, as typed, did not match the site register.
	measure 'Site Names Corrected' = CALCULATE ( COUNTROWS ( 'Action' ), 'Action'[Site Name Corrected] = TRUE (), REMOVEFILTERS ( 'Date' ) ) + 0
		formatString: #,0
		displayFolder: Data quality

	/// Actions whose site still matches no site after cleaning.
	measure 'Unmatched Site Names' = CALCULATE ( COUNTROWS ( 'Action' ), ISBLANK ( 'Action'[Site ID] ), REMOVEFILTERS ( 'Date' ) ) + 0
		formatString: #,0
		displayFolder: Data quality

	/// Actions with no owner recorded.
	measure 'Actions Without Owner' = CALCULATE ( COUNTROWS ( 'Action' ), 'Action'[Owner] = "Unassigned", REMOVEFILTERS ( 'Date' ) ) + 0
		formatString: #,0
		displayFolder: Data quality

	/// Actions that point at an inspection missing from the exports.
	measure 'Actions Without Inspection' = CALCULATE ( COUNTROWS ( 'Action' ), 'Action'[Inspection Found] = FALSE (), REMOVEFILTERS ( 'Date' ) ) + 0
		formatString: #,0
		displayFolder: Data quality

	measure 'Overdue Rank' =
			VAR days = MAX ( 'Action'[Days Overdue] )
			VAR ref = MAX ( 'Action'[Action Ref] )
			RETURN
			    IF (
			        NOT ISBLANK ( days ),
			        COUNTROWS (
			            FILTER (
			                ALLSELECTED ( 'Action'[Action Ref], 'Action'[Days Overdue] ),
			                'Action'[Days Overdue] > days || ( 'Action'[Days Overdue] = days && 'Action'[Action Ref] < ref )
			            )
			        ) + 1
			    )
		formatString: 0
		displayFolder: Helpers

	measure 'Context On-time' = "Target " & FORMAT ( [On-time Target], "0%" ) & " · last year " & FORMAT ( [On-time Closure % Last Year], "0%" )
		displayFolder: Labels

	measure 'Context Actions Due' = FORMAT ( [Actions Closed On Time] + 0, "#,0" ) & " closed by the due date"
		displayFolder: Labels

	measure 'Context Overdue' = IF ( [Overdue Actions] > 0, "Oldest " & [Oldest Overdue Days] & " days past due", "Nothing overdue" )
		displayFolder: Labels

	measure 'Context Site Open' = IF ( [Overdue Actions] > 0, [Overdue Actions] & " overdue", "None overdue" )
		displayFolder: Labels

	measure 'Context Unassigned' = "Owner not recorded in the actions list"
		displayFolder: Labels

	measure 'Context Names Corrected' = FORMAT ( [Unmatched Site Names], "#,0" ) & " still unmatched"
		displayFolder: Labels

	measure 'Context Without Owner' = "Shown as Unassigned"
		displayFolder: Labels

	measure 'Context Without Inspection' = "Kept, counted and listed below"
		displayFolder: Labels

	measure 'Colour On-time Value' = IF ( [On-time Closure %] < [On-time Target], "#C2453A", "#16324F" )
		displayFolder: Colours

	measure 'Colour Overdue Unassigned' = IF ( [Overdue Unassigned] > 0, "#C2453A", "#16324F" )
		displayFolder: Colours

	measure 'Colour Owner' = IF ( SELECTEDVALUE ( 'Action'[Owner] ) = "Unassigned", "#C2453A", "#1C2B3A" )
		displayFolder: Colours

	column 'Action Ref'
		dataType: string
		summarizeBy: none
		sourceColumn: Action Ref

	column 'Inspection ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Inspection ID

	column 'Site Name As Typed'
		dataType: string
		summarizeBy: none
		sourceColumn: Site Name As Typed

	column 'Site Name'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Site Name

	column 'Site Name Corrected'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Site Name Corrected

	column 'Site ID'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Site ID

	column Section
		dataType: string
		summarizeBy: none
		sourceColumn: Section

	column 'Raised Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: Raised Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Due Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: Due Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Closed Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: Closed Date

		annotation UnderlyingDateTimeDataType = Date

	column Owner
		dataType: string
		summarizeBy: none
		sourceColumn: Owner

	column Description
		dataType: string
		summarizeBy: none
		sourceColumn: Description

	column 'Inspection Found'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Inspection Found

	column 'Closed On Time'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Closed On Time

	/// Days past due, as at the as-at date. Blank unless the action is open and overdue.
	column 'Days Overdue' =
			VAR asAt = [As-at Date]
			RETURN
			    IF ( ISBLANK ( 'Action'[Closed Date] ) && 'Action'[Due Date] < asAt, DATEDIFF ( 'Action'[Due Date], asAt, DAY ) )
		dataType: int64
		formatString: #,0
		summarizeBy: none

	/// Where the action stands on the as-at date.
	column 'Action Status' =
			VAR asAt = [As-at Date]
			VAR due = 'Action'[Due Date]
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( 'Action'[Closed Date] ), "Closed",
			        due < asAt - 30, "Overdue over 30 days",
			        due < asAt, "Overdue up to 30 days",
			        "Not yet due"
			    )
		dataType: string
		summarizeBy: none
		sortByColumn: 'Action Status Order'

	/// What was wrong with the record as it came in, and was handled at load.
	column 'Data Issue' =
			VAR nameTyped = IF ( 'Action'[Site Name Corrected], "Site name typed differently" )
			VAR noOwner = IF ( 'Action'[Owner] = "Unassigned", "No owner recorded" )
			VAR noInspection = IF ( NOT 'Action'[Inspection Found], "Inspection not in the exports" )
			VAR issues = CONCATENATEX ( FILTER ( { nameTyped, noOwner, noInspection }, [Value] <> "" ), [Value], " · " )
			RETURN
			    IF ( issues = "", BLANK (), issues )
		dataType: string
		summarizeBy: none

	column 'Has Data Issue' = NOT ISBLANK ( 'Action'[Data Issue] )
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none

	column 'Action Status Order' =
			VAR asAt = [As-at Date]
			VAR due = 'Action'[Due Date]
			RETURN
			    SWITCH ( TRUE (), NOT ISBLANK ( 'Action'[Closed Date] ), 4, due < asAt - 30, 1, due < asAt, 2, 3 )
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none

	partition Action = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\actions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"raised_date", type date}, {"due_date", type date}, {"closed_date", type date}}),
				    #"Added Site Name" = Table.AddColumn(#"Changed Type", "Site Name", each Text.Proper(Text.Replace(Text.Trim([site_name]), "  ", " ")), type text),
				    #"Added Name Corrected" = Table.AddColumn(#"Added Site Name", "Site Name Corrected", each [site_name] <> [Site Name], type logical),
				    #"Merged Site" = Table.NestedJoin(#"Added Name Corrected", {"Site Name"}, Site, {"Site Name"}, "Site", JoinKind.LeftOuter),
				    #"Expanded Site" = Table.ExpandTableColumn(#"Merged Site", "Site", {"Site ID"}),
				    #"Replaced Blank Owner" = Table.ReplaceValue(#"Expanded Site", "", "Unassigned", Replacer.ReplaceValue, {"owner"}),
				    InspectionIDs = List.Buffer(Inspection[Inspection ID]),
				    #"Added Inspection Found" = Table.AddColumn(#"Replaced Blank Owner", "Inspection Found", each List.Contains(InspectionIDs, [inspection_id]), type logical),
				    #"Added Closed On Time" = Table.AddColumn(#"Added Inspection Found", "Closed On Time", each [closed_date] <> null and [closed_date] <= [due_date], type logical),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Closed On Time", {{"action_ref", "Action Ref"}, {"inspection_id", "Inspection ID"}, {"site_name", "Site Name As Typed"}, {"category", "Section"}, {"raised_date", "Raised Date"}, {"due_date", "Due Date"}, {"closed_date", "Closed Date"}, {"owner", "Owner"}, {"description", "Description"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table
