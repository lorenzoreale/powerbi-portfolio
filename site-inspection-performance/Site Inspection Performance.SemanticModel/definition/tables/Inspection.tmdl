/// One row per inspection: the latest version from the monthly exports.
table Inspection

	/// Inspection visits.
	measure Inspections = COUNTROWS ( 'Inspection' )
		formatString: #,0
		displayFolder: Activity

	/// Compliance at the most recent inspection in view.
	measure 'Latest Score' =
			VAR lastVisit = CALCULATE ( MAX ( 'Inspection'[Inspection Date] ), REMOVEFILTERS ( 'Date' ) )
			RETURN
			    CALCULATE ( [Compliance %], REMOVEFILTERS ( 'Date' ), 'Inspection'[Inspection Date] = lastVisit )
		formatString: 0.0%
		displayFolder: Compliance

	measure 'Context Last Inspection' = "on " & FORMAT ( CALCULATE ( MAX ( 'Inspection'[Inspection Date] ), REMOVEFILTERS ( 'Date' ) ), "d mmm yyyy" )
		displayFolder: Labels

	column 'Inspection ID'
		dataType: string
		summarizeBy: none
		sourceColumn: Inspection ID

	column 'Inspection Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: Inspection Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Submitted At'
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy hh:nn
		summarizeBy: none
		sourceColumn: Submitted At

	column 'Site ID'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Site ID

	column Inspector
		dataType: string
		summarizeBy: none
		sourceColumn: Inspector

	partition Inspection = m
		mode: import
		source =
				let
				    Source = #"Latest Export Rows",
				    #"Removed Other Columns" = Table.SelectColumns(Source, {"inspection_id", "submitted_at", "site_id", "inspector"}),
				    #"Added Inspection Date" = Table.AddColumn(#"Removed Other Columns", "Inspection Date", each DateTime.Date([submitted_at]), type date),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Inspection Date", {{"inspection_id", "Inspection ID"}, {"submitted_at", "Submitted At"}, {"site_id", "Site ID"}, {"inspector", "Inspector"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table
