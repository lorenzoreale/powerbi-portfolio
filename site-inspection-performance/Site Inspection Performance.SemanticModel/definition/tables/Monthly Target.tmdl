/// The inspection plan: planned visits per month. Used only through the Planned Inspections measure.
table 'Monthly Target'
	isHidden
	lineageTag: 732f6cd5-e2a6-45ec-90a1-e307b643865d

	column 'Month Start'
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: 85b927c4-16cc-42bb-be2b-a0cfccf08b82
		summarizeBy: none
		sourceColumn: Month Start

		annotation UnderlyingDateTimeDataType = Date

	column 'Planned Inspections'
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 60380272-0ac7-4cf7-b6cc-dd5aefa481bd
		summarizeBy: none
		sourceColumn: Planned Inspections

	partition 'Monthly Target' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\monthly_targets.csv"), [Delimiter = ",", Columns = 2, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {{"month_start", "Month Start"}, {"planned_inspections", "Planned Inspections"}}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Renamed Columns", {{"Month Start", type date}, {"Planned Inspections", Int64.Type}})
				in
				    #"Changed Types"

