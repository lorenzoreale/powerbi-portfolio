model 'Site Inspection Performance'
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["Date","Site","Person","Question","Inspection","Response","Action","MonthlyTarget","Data Folder","Inspections Clean","Sites Raw"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Date
ref table Site
ref table Person
ref table Question
ref table Inspection
ref table Response
ref table Action
ref table MonthlyTarget

