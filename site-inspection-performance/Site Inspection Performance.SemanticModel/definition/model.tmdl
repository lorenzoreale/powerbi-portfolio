model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Data Folder","Read Export","Export Rows","Latest Export Rows","Inspection","Response","Export File","Site","Region","Checklist","Action","Inspection Plan","Region Access","Date"]

annotation PBI_ProTooling = ["DevMode"]

ref table Inspection
ref table Response
ref table Action
ref table Site
ref table Region
ref table Checklist
ref table Date
ref table 'Inspection Plan'
ref table 'Export File'
ref table 'Region Access'
ref table 'Visit Rule'
ref table 'Compare By'

ref role 'Regional manager'
ref role 'Operations leadership'
