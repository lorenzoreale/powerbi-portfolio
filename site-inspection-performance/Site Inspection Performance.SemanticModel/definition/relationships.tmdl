relationship 'Inspection to Date'
	fromColumn: Inspection.'Inspection Date'
	toColumn: Date.Date

relationship 'Inspection to Site'
	fromColumn: Inspection.'Site ID'
	toColumn: Site.'Site ID'

relationship 'Response to Inspection'
	fromColumn: Response.'Inspection ID'
	toColumn: Inspection.'Inspection ID'

relationship 'Response to Checklist'
	fromColumn: Response.'Question Code'
	toColumn: Checklist.'Question Code'

relationship 'Site to Region'
	fromColumn: Site.Region
	toColumn: Region.Region

relationship 'Action to Site'
	fromColumn: Action.'Site ID'
	toColumn: Site.'Site ID'

relationship 'Action to Date'
	fromColumn: Action.'Due Date'
	toColumn: Date.Date

relationship 'Plan to Region'
	fromColumn: 'Inspection Plan'.Region
	toColumn: Region.Region

relationship 'Plan to Date'
	fromColumn: 'Inspection Plan'.'Month Start'
	toColumn: Date.Date
