relationship 'Inspection to Date'
	fromColumn: Inspection.'Inspection Date'
	toColumn: Date.Date

relationship 'Inspection to Site'
	fromColumn: Inspection.SiteKey
	toColumn: Site.SiteKey

relationship 'Inspection to Inspector'
	fromColumn: Inspection.InspectorKey
	toColumn: Person.PersonKey

relationship 'Response to Inspection'
	fromColumn: Response.InspectionID
	toColumn: Inspection.InspectionID

relationship 'Response to Question'
	fromColumn: Response.QuestionKey
	toColumn: Question.QuestionKey

relationship 'Action to Date (raised)'
	fromColumn: Action.'Raised Date'
	toColumn: Date.Date

relationship 'Action to Date (due)'
	isActive: false
	fromColumn: Action.'Due Date'
	toColumn: Date.Date

relationship 'Action to Site'
	fromColumn: Action.SiteKey
	toColumn: Site.SiteKey

relationship 'Action to Owner'
	fromColumn: Action.OwnerKey
	toColumn: Person.PersonKey

relationship 'Monthly Target to Date'
	fromColumn: 'Monthly Target'.'Month Start'
	toColumn: Date.Date

