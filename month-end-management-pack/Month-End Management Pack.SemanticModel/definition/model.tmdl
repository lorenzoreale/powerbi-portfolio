model 'Month-End Management Pack'
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling"]

ref table Calendar
ref table Scenario
ref table Entity
ref table 'Service Line'
ref table Account
ref table Client
ref table 'P&L Line'
ref table Ledger
ref table Capacity

