model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Data Folder","Calendar","Entity","Service Line","Account","Client","Ledger","Capacity","P&L Line","Bridge Step","Close Point"]

ref table Calendar
ref table Entity
ref table 'Service Line'
ref table Account
ref table Client
ref table Ledger
ref table Capacity
ref table 'P&L Line'
ref table 'Bridge Step'
ref table 'Close Point'
