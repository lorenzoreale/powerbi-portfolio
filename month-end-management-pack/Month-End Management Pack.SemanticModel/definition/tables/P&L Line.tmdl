/// The profit and loss statement, one row per line in the order finance presents it. Not related: the statement measures read the line in context.
table 'P&L Line'

	column 'Line Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Line Order]

	column Line
		dataType: string
		summarizeBy: none
		sourceColumn: [Line]
		sortByColumn: 'Line Order'

	/// Account, Subtotal or Margin.
	column 'Line Type'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: [Line Type]

	/// The account behind an account line.
	column 'Account Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: [Account Code]

	/// The account types a subtotal adds up. For a margin, the numerator; the denominator is always revenue.
	column 'Account Types'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: [Account Types]

	partition 'P&L Line' = calculated
		mode: import
		source =
				DATATABLE (
				    "Line Order", INTEGER,
				    "Line", STRING,
				    "Line Type", STRING,
				    "Account Code", STRING,
				    "Account Types", STRING,
				    {
				        { 1, "Advisory fees", "Account", "4100", "" },
				        { 2, "Managed services fees", "Account", "4200", "" },
				        { 3, "Project fees", "Account", "4300", "" },
				        { 4, "Support fees", "Account", "4400", "" },
				        { 5, "Revenue", "Subtotal", "", "Revenue" },
				        { 6, "Delivery staff", "Account", "5100", "" },
				        { 7, "Subcontractors", "Account", "5200", "" },
				        { 8, "Recharged expenses", "Account", "5300", "" },
				        { 9, "Direct costs", "Subtotal", "", "Direct costs" },
				        { 10, "Gross profit", "Subtotal", "", "Revenue|Direct costs" },
				        { 11, "Gross margin", "Margin", "", "Revenue|Direct costs" },
				        { 12, "Admin staff", "Account", "6100", "" },
				        { 13, "Premises", "Account", "6200", "" },
				        { 14, "Technology", "Account", "6300", "" },
				        { 15, "Marketing", "Account", "6400", "" },
				        { 16, "Professional fees", "Account", "6500", "" },
				        { 17, "Depreciation", "Account", "6600", "" },
				        { 18, "Other admin", "Account", "6900", "" },
				        { 19, "Overheads", "Subtotal", "", "Overheads" },
				        { 20, "Operating profit", "Subtotal", "", "Revenue|Direct costs|Overheads" },
				        { 21, "Operating margin", "Margin", "", "Revenue|Direct costs|Overheads" }
				    }
				)
