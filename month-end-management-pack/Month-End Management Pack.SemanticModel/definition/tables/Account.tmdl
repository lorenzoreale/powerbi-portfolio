/// The chart of accounts used by the pack: four fee accounts, three direct cost accounts and seven overhead accounts.
table Account

	column 'Account Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Account Code

	column Account
		dataType: string
		summarizeBy: none
		sourceColumn: Account
		sortByColumn: 'Sort Order'

	/// Revenue, Direct costs or Overheads.
	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column 'Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Sort Order

	partition Account = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\account.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {{"account_code", "Account Code"}, {"account", "Account"}, {"category", "Category"}, {"sort_order", "Sort Order"}}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Renamed Columns", {{"Account Code", type text}, {"Account", type text}, {"Category", type text}, {"Sort Order", Int64.Type}})
				in
				    #"Changed Types"

