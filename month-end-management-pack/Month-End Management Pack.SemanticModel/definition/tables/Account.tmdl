/// The 14 profit and loss accounts of the chart of accounts.
table Account

	column 'Account Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Account Code

	column Account
		dataType: string
		summarizeBy: none
		sourceColumn: Account
		sortByColumn: 'Sort Order'

	column 'Account Type'
		dataType: string
		summarizeBy: none
		sourceColumn: Account Type

	column 'Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Sort Order

	/// 1 for revenue, -1 for costs. Turns the budget, typed with costs as positive amounts, into profit signs.
	column Sign
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Sign

	partition Account = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Account = Source{[Schema = "rpt", Item = "Account"]}[Data]
				in
				    Account

	annotation PBI_ResultType = Table
