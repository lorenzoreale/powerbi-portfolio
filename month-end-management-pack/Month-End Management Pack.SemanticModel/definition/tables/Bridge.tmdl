/// Disconnected presentation table for the operating-profit bridge waterfall. Read by the Bridge Value measure; no relationship to the facts.
table Bridge
	lineageTag: 04441d51-75da-41bc-9bfd-ac9d483fa49d

	column Step
		dataType: string
		lineageTag: db7680a2-2614-4141-8c90-b41ddd0d4d98
		summarizeBy: none
		sourceColumn: Step
		sortByColumn: 'Sort Order'

	column 'Sort Order'
		dataType: int64
		isHidden
		lineageTag: 9df7e715-3abc-4490-81cf-d1ddd257e108
		summarizeBy: none
		sourceColumn: Sort Order

	column 'Bridge Type'
		dataType: string
		isHidden
		lineageTag: 333832c7-1559-467a-a250-4f4be8b5a385
		summarizeBy: none
