	column Arg
		dataType: string
		isHidden
		lineageTag: 58a837b7-2966-4f15-9632-217d04a6318e
		summarizeBy: none
		sourceColumn: Arg

	partition Bridge = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [Step = text, #"Sort Order" = Int64.Type, #"Bridge Type" = text, Arg = text],
				        {
				            {"Budget op. profit", 1, "anchor", null},
				            {"Advisory", 2, "rev", "Advisory"},
				            {"Managed Services", 3, "rev", "Managed Services"},
				            {"Projects", 4, "rev", "Projects"},
				            {"Support", 5, "rev", "Support"},
				            {"Direct costs", 6, "direct", null},
				            {"Overheads", 7, "overhead", null}
				        }
