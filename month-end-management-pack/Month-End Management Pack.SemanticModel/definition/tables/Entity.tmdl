/// The three companies of the group.
table Entity

	column 'Entity Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Entity Code

	column Company
		dataType: string
		summarizeBy: none
		sourceColumn: Company

	partition Entity = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Entity = Source{[Schema = "rpt", Item = "Entity"]}[Data]
				in
				    Entity

	annotation PBI_ResultType = Table
