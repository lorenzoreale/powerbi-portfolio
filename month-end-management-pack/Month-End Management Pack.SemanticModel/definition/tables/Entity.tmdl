/// The three companies in the group. Used to read the P&L for one company at a time.
table Entity

	column 'Entity Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Entity Code

	column Company
		dataType: string
		summarizeBy: none
		sourceColumn: Company

	partition Entity = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\entity.csv"), [Delimiter = ",", Columns = 2, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {{"entity_code", "Entity Code"}, {"entity_name", "Company"}}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Renamed Columns", {{"Entity Code", type text}, {"Company", type text}})
				in
				    #"Changed Types"

