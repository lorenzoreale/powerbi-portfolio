/// The four service lines that bill clients, and Central for the overheads.
table 'Service Line'

	column 'Service Line'
		dataType: string
		summarizeBy: none
		sourceColumn: Service Line
		sortByColumn: 'Sort Order'

	column 'Service Line Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Service Line Code

	column 'Client Facing'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Client Facing

	column 'Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Sort Order

	partition 'Service Line' = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    ServiceLine = Source{[Schema = "rpt", Item = "ServiceLine"]}[Data]
				in
				    ServiceLine

	annotation PBI_ResultType = Table
