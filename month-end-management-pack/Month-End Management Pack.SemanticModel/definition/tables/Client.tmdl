/// The 13 clients, plus Unallocated for ledger lines posted with no client.
table Client

	/// The lowest gross margin the partners accept on a client: 30%.
	measure 'Margin Floor' = 0.3
		formatString: 0%
		displayFolder: Clients

	measure 'Revenue YTD' = CALCULATE ( [Revenue], Period[Period] = "Year to date" )
		formatString: #,0,;(#,0,);-
		displayFolder: Clients

	measure 'Revenue YTD Last Year' = CALCULATE ( [Revenue], Period[Period] = "Year to date last year" )
		formatString: #,0,;(#,0,);-
		displayFolder: Clients

	measure 'Gross Margin % YTD' = CALCULATE ( [Gross Margin %], Period[Period] = "Year to date" )
		formatString: 0.0%
		displayFolder: Clients

	measure 'Gross Margin % YTD Last Year' = CALCULATE ( [Gross Margin %], Period[Period] = "Year to date last year" )
		formatString: 0.0%
		displayFolder: Clients

	/// Change in gross margin against the same months of last year, in points.
	measure 'Margin Change' = IF ( NOT ISBLANK ( [Gross Margin % YTD Last Year] ), ( [Gross Margin % YTD] - [Gross Margin % YTD Last Year] ) * 100 )
		formatString: +0.0" pts";(0.0)" pts";0.0" pts"
		displayFolder: Clients

	/// Share of the year's client revenue taken by this client and every larger one.
	measure 'Cumulative Share' =
			VAR thisRevenue = [Revenue YTD]
			VAR clients =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( Client[Client] ), REMOVEFILTERS ( Client ), Client[Is Client] = TRUE () ),
			        "@Revenue", [Revenue YTD]
			    )
			RETURN
			    DIVIDE ( SUMX ( FILTER ( clients, [@Revenue] >= thisRevenue ), [@Revenue] ), SUMX ( clients, [@Revenue] ) )
		formatString: 0%
		displayFolder: Clients

	measure 'Colour Client Margin' = IF ( [Gross Margin % YTD] < [Margin Floor], "#B0402F", "#146B60" )
		displayFolder: Colours

	measure 'Colour Client Margin Month' = IF ( [Gross Margin %] < [Margin Floor], "#B0402F", "#232A2E" )
		displayFolder: Colours

	measure 'Colour Client Margin YTD' = IF ( [Gross Margin % YTD] < [Margin Floor], "#B0402F", "#232A2E" )
		displayFolder: Colours

	measure 'Colour Margin Change' = IF ( [Margin Change] < 0, "#B0402F", "#232A2E" )
		displayFolder: Colours

	column 'Client Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Client Code

	column Client
		dataType: string
		summarizeBy: none
		sourceColumn: Client

	column 'Client Since'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Client Since

	column 'Is Client'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: Is Client

	partition Client = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Client = Source{[Schema = "rpt", Item = "Client"]}[Data]
				in
				    Client

	annotation PBI_ResultType = Table
