/// One row per month, January 2025 to June 2026. The pack reports one month at a time, so the calendar is kept at month grain.
table Calendar

	column 'Month Key'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Key

	/// Short label, for example Jun 2026. Sorted by Month Key.
	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Key'

	/// Long label used in titles, for example June 2026.
	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: 'Month Key'

	/// First day of the month. The axis of the trend charts.
	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: Month Start

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Number

	/// Weekdays less bank holidays in England and Wales.
	column 'Working Days'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Working Days

	partition Calendar = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\calendar.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {{"month_key", "Month Key"}, {"month", "Month"}, {"month_start", "Month Start"}, {"year", "Year"}, {"month_number", "Month Number"}, {"working_days", "Working Days"}}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Renamed Columns", {{"Month Key", Int64.Type}, {"Month", type text}, {"Month Start", type date}, {"Year", Int64.Type}, {"Month Number", Int64.Type}, {"Working Days", Int64.Type}}),
				    #"Added Month Name" = Table.AddColumn(#"Changed Types", "Month Name", each Date.ToText([Month Start], "MMMM yyyy", "en-GB"), type text)
				in
				    #"Added Month Name"

