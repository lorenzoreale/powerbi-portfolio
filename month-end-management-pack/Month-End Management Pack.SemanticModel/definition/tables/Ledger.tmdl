/// One row per month, scenario (Actual or Budget), company, service line, account and client. Amounts are signed: revenue positive, costs negative, so adding them up gives profit at any level and Actual minus Budget is favourable when positive.
table Ledger

	/// Actual amounts, before any category filter. The base of every actual figure.
	measure Actual = CALCULATE ( SUM ( Ledger[Amount] ), Ledger[Scenario] = "Actual" )
		formatString: #,0,;(#,0,);-
		isHidden
		displayFolder: Base

	/// Budget amounts, before any category filter.
	measure Budget = CALCULATE ( SUM ( Ledger[Amount] ), Ledger[Scenario] = "Budget" )
		formatString: #,0,;(#,0,);-
		isHidden
		displayFolder: Base

	/// Revenue from every service line, in pounds.
	measure Revenue = CALCULATE ( [Actual], Account[Category] = "Revenue" )
		formatString: #,0,;(#,0,);-
		displayFolder: Revenue

	/// Budgeted revenue: the flexed budget, 82% utilisation of the hours available at the rate card.
	measure 'Revenue Budget' = CALCULATE ( [Budget], Account[Category] = "Revenue" )
		formatString: #,0,;(#,0,);-
		displayFolder: Revenue

	/// Actual minus budgeted revenue. Positive is favourable.
	measure 'Revenue Variance' = [Revenue] - [Revenue Budget]
		formatString: #,0,;(#,0,);-
		displayFolder: Revenue

	/// Revenue variance as a share of budget.
	measure 'Revenue Variance %' = DIVIDE ( [Revenue Variance], [Revenue Budget] )
		formatString: 0.0%;(0.0%);-
		displayFolder: Revenue

	/// Direct costs, signed negative.
	measure 'Direct Costs' = CALCULATE ( [Actual], Account[Category] = "Direct costs" )
		formatString: #,0,;(#,0,);-
		displayFolder: Costs

	/// Budgeted direct costs, signed negative.
	measure 'Direct Costs Budget' = CALCULATE ( [Budget], Account[Category] = "Direct costs" )
		formatString: #,0,;(#,0,);-
		displayFolder: Costs

	/// Positive when direct costs came in under budget.
	measure 'Direct Costs Variance' = [Direct Costs] - [Direct Costs Budget]
		formatString: #,0,;(#,0,);-
		displayFolder: Costs

	/// Overheads, signed negative.
	measure Overheads = CALCULATE ( [Actual], Account[Category] = "Overheads" )
		formatString: #,0,;(#,0,);-
		displayFolder: Costs

	/// Budgeted overheads, signed negative.
	measure 'Overheads Budget' = CALCULATE ( [Budget], Account[Category] = "Overheads" )
		formatString: #,0,;(#,0,);-
		displayFolder: Costs

	/// Positive when overheads came in under budget.
	measure 'Overheads Variance' = [Overheads] - [Overheads Budget]
		formatString: #,0,;(#,0,);-
		displayFolder: Costs

	/// Actual spent on accounts that have no budget at all, such as Depreciation. Shows where a budget line is missing rather than a real overspend.
	measure 'Actual Without Budget' = SUMX ( VALUES ( Account[Account Code] ), IF ( ISBLANK ( [Budget] ), [Actual] ) )
		formatString: #,0,;(#,0,);-
		displayFolder: Costs

	/// Revenue less direct costs.
	measure 'Gross Profit' = CALCULATE ( [Actual], Account[Category] IN { "Revenue", "Direct costs" } )
		formatString: #,0,;(#,0,);-
		displayFolder: Profit

	/// Budgeted revenue less budgeted direct costs.
	measure 'Gross Profit Budget' = CALCULATE ( [Budget], Account[Category] IN { "Revenue", "Direct costs" } )
		formatString: #,0,;(#,0,);-
		displayFolder: Profit

	/// Actual minus budgeted gross profit. Positive is favourable.
	measure 'Gross Profit Variance' = [Gross Profit] - [Gross Profit Budget]
		formatString: #,0,;(#,0,);-
		displayFolder: Profit

	/// Gross profit as a share of revenue.
	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Revenue] )
		formatString: 0.0%
		displayFolder: Profit

	/// Budgeted gross profit as a share of budgeted revenue.
	measure 'Gross Margin % Budget' = DIVIDE ( [Gross Profit Budget], [Revenue Budget] )
		formatString: 0.0%
		displayFolder: Profit

	/// Gross margin against budget, in percentage points.
	measure 'Gross Margin Variance (pts)' = ( [Gross Margin %] - [Gross Margin % Budget] ) * 100
		formatString: 0.0;(0.0);-
		displayFolder: Profit

	/// All accounts together: revenue less direct costs less overheads.
	measure 'Operating Profit' = [Actual]
		formatString: #,0,;(#,0,);-
		displayFolder: Profit

	/// Budgeted operating profit: every account in the budget.
	measure 'Operating Profit Budget' = [Budget]
		formatString: #,0,;(#,0,);-
		displayFolder: Profit

	/// Actual minus budgeted operating profit. Positive is favourable.
	measure 'Operating Profit Variance' = [Operating Profit] - [Operating Profit Budget]
		formatString: #,0,;(#,0,);-
		displayFolder: Profit

	/// Operating profit variance as a share of budget.
	measure 'Operating Profit Variance %' = DIVIDE ( [Operating Profit Variance], ABS ( [Operating Profit Budget] ) )
		formatString: 0.0%;(0.0%);-
		displayFolder: Profit

	/// Operating profit as a share of revenue.
	measure 'Operating Margin %' = DIVIDE ( [Operating Profit], [Revenue] )
		formatString: 0.0%
		displayFolder: Profit

	/// Budgeted operating profit as a share of budgeted revenue.
	measure 'Operating Margin % Budget' = DIVIDE ( [Operating Profit Budget], [Revenue Budget] )
		formatString: 0.0%
		displayFolder: Profit

	/// Revenue from 1 January to the month selected.
	measure 'Revenue YTD' =
			VAR lastMonth = MAX ( 'Calendar'[Month Key] )
			VAR thisYear = MAX ( 'Calendar'[Year] )
			RETURN
			    CALCULATE ( [Revenue], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = thisYear, 'Calendar'[Month Key] <= lastMonth )
		formatString: #,0,;(#,0,);-
		displayFolder: Year to date

	/// Budgeted revenue from 1 January to the month selected.
	measure 'Revenue Budget YTD' =
			VAR lastMonth = MAX ( 'Calendar'[Month Key] )
			VAR thisYear = MAX ( 'Calendar'[Year] )
			RETURN
			    CALCULATE ( [Revenue Budget], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = thisYear, 'Calendar'[Month Key] <= lastMonth )
		formatString: #,0,;(#,0,);-
		displayFolder: Year to date

	/// Year-to-date revenue against budget. Positive is favourable.
	measure 'Revenue Variance YTD' = [Revenue YTD] - [Revenue Budget YTD]
		formatString: #,0,;(#,0,);-
		displayFolder: Year to date

	/// Gross profit from 1 January to the month selected.
	measure 'Gross Profit YTD' =
			VAR lastMonth = MAX ( 'Calendar'[Month Key] )
			VAR thisYear = MAX ( 'Calendar'[Year] )
			RETURN
			    CALCULATE ( [Gross Profit], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = thisYear, 'Calendar'[Month Key] <= lastMonth )
		formatString: #,0,;(#,0,);-
		displayFolder: Year to date

	/// Budgeted gross profit from 1 January to the month selected.
	measure 'Gross Profit Budget YTD' =
			VAR lastMonth = MAX ( 'Calendar'[Month Key] )
			VAR thisYear = MAX ( 'Calendar'[Year] )
			RETURN
			    CALCULATE ( [Gross Profit Budget], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = thisYear, 'Calendar'[Month Key] <= lastMonth )
		formatString: #,0,;(#,0,);-
		displayFolder: Year to date

	/// Year-to-date gross profit against budget. Positive is favourable.
	measure 'Gross Profit Variance YTD' = [Gross Profit YTD] - [Gross Profit Budget YTD]
		formatString: #,0,;(#,0,);-
		displayFolder: Year to date

	/// Gross margin from 1 January to the month selected.
	measure 'Gross Margin % YTD' = DIVIDE ( [Gross Profit YTD], [Revenue YTD] )
		formatString: 0.0%
		displayFolder: Year to date

	/// Operating profit from 1 January to the month selected.
	measure 'Operating Profit YTD' =
			VAR lastMonth = MAX ( 'Calendar'[Month Key] )
			VAR thisYear = MAX ( 'Calendar'[Year] )
			RETURN
			    CALCULATE ( [Operating Profit], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = thisYear, 'Calendar'[Month Key] <= lastMonth )
		formatString: #,0,;(#,0,);-
		displayFolder: Year to date

	/// Budgeted operating profit from 1 January to the month selected.
	measure 'Operating Profit Budget YTD' =
			VAR lastMonth = MAX ( 'Calendar'[Month Key] )
			VAR thisYear = MAX ( 'Calendar'[Year] )
			RETURN
			    CALCULATE ( [Operating Profit Budget], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = thisYear, 'Calendar'[Month Key] <= lastMonth )
		formatString: #,0,;(#,0,);-
		displayFolder: Year to date

	/// Year-to-date operating profit against budget. Positive is favourable.
	measure 'Operating Profit Variance YTD' = [Operating Profit YTD] - [Operating Profit Budget YTD]
		formatString: #,0,;(#,0,);-
		displayFolder: Year to date

	/// Months in the year-to-date figures, for the context lines.
	measure 'Months YTD' = MAX ( 'Calendar'[Month Number] )
		formatString: 0
		isHidden
		displayFolder: Year to date

	/// Subtitle of every page header: the month and the unit.
	measure 'Header Subtitle' = SELECTEDVALUE ( 'Calendar'[Month Name] ) & " · £000 unless stated"
		displayFolder: Report text

	/// First line of the Variance page.
	measure 'Headline Variance' =
			VAR profit = [Operating Profit]
			VAR gap = [Operating Profit Variance]
			RETURN
			    "Operating profit was £" & FORMAT ( profit / 1000, "#,0" ) & "k in " & SELECTEDVALUE ( 'Calendar'[Month Name] ) & ", £"
			        & FORMAT ( ABS ( gap ) / 1000, "#,0" ) & "k (" & FORMAT ( ABS ( [Operating Profit Variance %] ), "0.0%" ) & ") "
			        & IF ( gap < 0, "below", "above" ) & " budget."
		displayFolder: Report text

	/// Context line under revenue.
	measure 'Context Revenue' = FORMAT ( [Revenue Variance] / 1000, "#,0;(#,0)" ) & " against budget · " & FORMAT ( [Revenue Variance %], "0.0%;(0.0%)" )
		displayFolder: Report text

	/// Context line under operating profit.
	measure 'Context Operating Profit' = FORMAT ( [Operating Profit Variance] / 1000, "#,0;(#,0)" ) & " against budget · " & FORMAT ( [Operating Margin %], "0.0%" ) & " margin vs " & FORMAT ( [Operating Margin % Budget], "0.0%" )
		displayFolder: Report text

	/// Context line under operating profit for the year to date.
	measure 'Context Operating Profit YTD' = FORMAT ( [Operating Profit Variance YTD] / 1000, "#,0;(#,0)" ) & " against budget · " & [Months YTD] & IF ( [Months YTD] = 1, " month", " months" )
		displayFolder: Report text

	/// Red for an adverse revenue variance, grey otherwise.
	measure 'Colour Revenue Context' = IF ( [Revenue Variance] < 0, "#B23A2E", "#5D6B79" )
		displayFolder: Colours

	/// Colour of the context line under operating profit: red when behind budget, grey otherwise.
	measure 'Colour Operating Profit Context' = IF ( [Operating Profit Variance] < 0, "#B23A2E", "#5D6B79" )
		displayFolder: Colours

	/// Colour of the context line under year-to-date operating profit: red when behind budget, grey otherwise.
	measure 'Colour Operating Profit YTD Context' = IF ( [Operating Profit Variance YTD] < 0, "#B23A2E", "#5D6B79" )
		displayFolder: Colours

	/// Red for adverse variances in tables, ink otherwise.
	measure 'Colour Revenue Variance' = IF ( [Revenue Variance] < 0, "#B23A2E", "#1D2A36" )
		displayFolder: Colours

	/// Font colour for a gross margin variance: red when behind budget.
	measure 'Colour Gross Margin Variance' = IF ( [Gross Margin Variance (pts)] < 0, "#B23A2E", "#1D2A36" )
		displayFolder: Colours

	/// Font colour for the year-to-date revenue variance: red when behind budget.
	measure 'Colour Revenue Variance YTD' = IF ( [Revenue Variance YTD] < 0, "#B23A2E", "#1D2A36" )
		displayFolder: Colours

	/// Font colour for the year-to-date gross profit variance: red when behind budget.
	measure 'Colour Gross Profit Variance YTD' = IF ( [Gross Profit Variance YTD] < 0, "#B23A2E", "#1D2A36" )
		displayFolder: Colours

	/// Account variance for the largest-variances chart: actual minus budget on any line, favourable when positive.
	measure 'Account Variance' = [Actual] - [Budget]
		formatString: #,0,;(#,0,);-
		displayFolder: Costs

	/// Bar colour for account variances: red adverse, green favourable.
	measure 'Colour Account Variance' = IF ( [Account Variance] < 0, "#B23A2E", "#2E7D57" )
		displayFolder: Colours

	/// Visual title for the largest-variances chart: the account most against budget.
	measure 'Title Account Variances' =
			VAR accounts = ADDCOLUMNS ( VALUES ( Account[Account] ), "@Variance", [Account Variance] )
			VAR worst = TOPN ( 1, accounts, [@Variance], ASC )
			VAR gap = MAXX ( worst, [@Variance] )
			RETURN
			    IF ( gap < 0, "Furthest behind: " & MAXX ( worst, Account[Account] ) & ", £" & FORMAT ( - gap / 1000, "#,0" ) & "k", "Every line is at or better than budget" )
		displayFolder: Report text

	column 'Month Key'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Key

	/// Actual or Budget. Hidden: the measures pick the scenario.
	column Scenario
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Scenario

	column 'Entity Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Entity Code

	column 'Service Line'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Service Line

	column 'Account Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Account Code

	column Client
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Client

	/// Signed amount in pounds. Hidden: use the measures.
	column Amount
		dataType: decimal
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: Amount

	partition Ledger = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\ledger.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Removed Duplicate Rows" = Table.Distinct(#"Promoted Headers"),
				    #"Changed Types" = Table.TransformColumnTypes(#"Removed Duplicate Rows", {{"month_key", Int64.Type}, {"scenario", type text}, {"entity_code", type text}, {"service_line", type text}, {"account_code", type text}, {"client", type text}, {"amount", Currency.Type}}),
				    #"Cleaned Client Names" = Table.TransformColumns(#"Changed Types", {{"client", each if _ = "" then "Unallocated" else Text.Proper(Text.Replace(Text.Trim(_), "  ", " ")), type text}}),
				    #"Costs Negative" = Table.ReplaceValue(#"Cleaned Client Names", each [amount], each if Text.StartsWith([account_code], "REV") then [amount] else - Number.Abs([amount]), Replacer.ReplaceValue, {"amount"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Costs Negative", {{"month_key", "Month Key"}, {"scenario", "Scenario"}, {"entity_code", "Entity Code"}, {"service_line", "Service Line"}, {"account_code", "Account Code"}, {"client", "Client"}, {"amount", "Amount"}}),
				    #"Amount Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"Amount", Currency.Type}})
				in
				    #"Amount Type"

