/// The steps between budget and actual operating profit, for the bridge on the Summary page.
table 'Bridge Step'

	/// Operating profit split into the steps of the bridge, for the budget and for the actual. The difference between the two is each step's effect.
	measure 'Bridge Component' =
			VAR isActual = SELECTEDVALUE ( Scenario[Scenario] ) = "Actual"
			RETURN
			    SUMX (
			        VALUES ( 'Bridge Step'[Step] ),
			        SWITCH (
			            'Bridge Step'[Step],
			            "Capacity", IF ( isActual, [Capacity Effect], 0 ),
			            "Billable hours", IF ( isActual, [Hours Effect], 0 ),
			            "Billing rates", [Revenue Budget] + IF ( isActual, [Rate Effect], 0 ),
			            "Direct costs", IF ( isActual, [Direct Costs], [Direct Costs Budget] ),
			            "Overheads", IF ( isActual, [Overheads], [Overheads Budget] )
			        )
			    )
		formatString: #,0,.0;(#,0,.0);0.0
		displayFolder: Bridge

	measure 'Bridge Axis Start' =
			VAR budget = [Operating Profit Budget]
			VAR steps = { [Capacity Effect], [Hours Effect], [Rate Effect], [Direct Costs Variance], [Overheads Variance] }
			VAR low = budget + SUMX ( FILTER ( steps, [Value] < 0 ), [Value] )
			VAR high = budget + SUMX ( FILTER ( steps, [Value] > 0 ), [Value] )
			VAR range = MAX ( high - low, 1 )
			RETURN
			    IF ( low >= 0, MAX ( 0, FLOOR ( low - range * 0.6, 10000 ) ), FLOOR ( low - range * 0.15, 10000 ) )
		formatString: #,0,
		isHidden
		displayFolder: Bridge

	measure 'Bridge Axis End' =
			VAR budget = [Operating Profit Budget]
			VAR steps = { [Capacity Effect], [Hours Effect], [Rate Effect], [Direct Costs Variance], [Overheads Variance] }
			VAR low = budget + SUMX ( FILTER ( steps, [Value] < 0 ), [Value] )
			VAR high = budget + SUMX ( FILTER ( steps, [Value] > 0 ), [Value] )
			VAR range = MAX ( high - low, 1 )
			RETURN
			    IF ( high <= 0, MIN ( 0, CEILING ( high + range * 0.6, 10000 ) ), CEILING ( high + range * 0.15, 10000 ) )
		formatString: #,0,
		isHidden
		displayFolder: Bridge

	column 'Step Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Step Order]

	column Step
		dataType: string
		summarizeBy: none
		sourceColumn: [Step]
		sortByColumn: 'Step Order'

	partition 'Bridge Step' = calculated
		mode: import
		source =
				DATATABLE (
				    "Step Order", INTEGER,
				    "Step", STRING,
				    {
				        { 1, "Capacity" },
				        { 2, "Billable hours" },
				        { 3, "Billing rates" },
				        { 4, "Direct costs" },
				        { 5, "Overheads" }
				    }
				)
