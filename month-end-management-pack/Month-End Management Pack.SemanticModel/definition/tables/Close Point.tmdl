/// The points for the month-end close meeting, one row each. Each point is written from the data by its own measure; a point with nothing to say is blank and drops out of the list.
table 'Close Point'

	/// The service line whose gross margin fell furthest below budget (when more than half a point), and the direct cost that did most to push it down (when it ran at least £5k over).
	measure 'Point Margin' =
			VAR lines = ADDCOLUMNS ( FILTER ( VALUES ( 'Service Line'[Service Line] ), NOT ISBLANK ( [Revenue] ) ), "@Gap", [Gross Margin %] - [Gross Margin % Budget] )
			VAR worst = TOPN ( 1, lines, [@Gap], ASC )
			VAR worstLine = MAXX ( worst, 'Service Line'[Service Line] )
			VAR margin = CALCULATE ( [Gross Margin %], 'Service Line'[Service Line] = worstLine )
			VAR budgetMargin = CALCULATE ( [Gross Margin % Budget], 'Service Line'[Service Line] = worstLine )
			VAR costs = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Account[Account] ), Account[Category] = "Direct costs" ), "@Variance", CALCULATE ( [Direct Costs Variance], 'Service Line'[Service Line] = worstLine ) )
			VAR worstCost = TOPN ( 1, costs, [@Variance], ASC )
			VAR costVariance = MAXX ( worstCost, [@Variance] )
			RETURN
			    IF (
			        MAXX ( worst, [@Gap] ) >= -0.005,
			        "No service line is more than half a point behind its budgeted gross margin.",
			        worstLine & ": gross margin " & FORMAT ( margin, "0.0%" ) & " against " & FORMAT ( budgetMargin, "0.0%" ) & " budget."
			            & IF ( costVariance <= -5000, " " & MAXX ( worstCost, Account[Account] ) & " ran £" & FORMAT ( - costVariance / 1000, "#,0" ) & "k over." )
			    )
		displayFolder: Points

	/// The service line whose average billing rate cost the most revenue against the rate card, when that is at least £5k.
	measure 'Point Rates' =
			VAR lines = ADDCOLUMNS ( FILTER ( VALUES ( 'Service Line'[Service Line] ), NOT ISBLANK ( [Billable Hours] ) ), "@Effect", [Rate Effect] )
			VAR worst = TOPN ( 1, lines, [@Effect], ASC )
			VAR worstLine = MAXX ( worst, 'Service Line'[Service Line] )
			VAR effect = MAXX ( worst, [@Effect] )
			RETURN
			    IF (
			        effect <= -5000,
			        worstLine & ": billed £" & FORMAT ( CALCULATE ( [Billing Rate], 'Service Line'[Service Line] = worstLine ), "#,0" ) & " an hour against the £"
			            & FORMAT ( CALCULATE ( [Billing Rate Budget], 'Service Line'[Service Line] = worstLine ), "#,0" ) & " rate card, £" & FORMAT ( - effect / 1000, "#,0" ) & "k of revenue.",
			        "Every service line billed within £5k of its rate card."
			    )
		displayFolder: Points

	/// Overheads against budget, and the budgeted overhead that ran most over (when by at least £5k).
	measure 'Point Overheads' =
			VAR gap = [Overheads Variance]
			VAR accounts = ADDCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( Account[Account] ), Account[Category] = "Overheads" ), NOT ISBLANK ( [Budget] ) ), "@Variance", [Overheads Variance] )
			VAR worst = TOPN ( 1, accounts, [@Variance], ASC )
			VAR worstVariance = MAXX ( worst, [@Variance] )
			RETURN
			    "£" & FORMAT ( ABS ( gap ) / 1000, "#,0" ) & "k " & IF ( gap >= 0, "under", "over" ) & " budget"
			        & IF ( worstVariance <= -5000, IF ( gap >= 0, ", but ", ". " ) & MAXX ( worst, Account[Account] ) & " ran £" & FORMAT ( - worstVariance / 1000, "#,0" ) & "k over.", "." )
		displayFolder: Points

	/// Money spent on accounts with no budget line. Blank when every account has a budget.
	measure 'Point Missing Budget' =
			VAR unbudgeted = [Actual Without Budget]
			VAR accounts = CONCATENATEX ( FILTER ( VALUES ( Account[Account] ), ISBLANK ( [Budget] ) && NOT ISBLANK ( [Actual] ) ), Account[Account], " and " )
			RETURN
			    IF ( unbudgeted < 0, accounts & ": £" & FORMAT ( - unbudgeted / 1000, "#,0" ) & "k spent with no budget line. Its budget sits in Other admin." )
		displayFolder: Points

	/// Clients below the margin floor.
	measure 'Point Clients' =
			VAR floor = [Client Margin Floor]
			VAR below = [Clients Below Floor]
			RETURN
			    SWITCH (
			        TRUE (),
			        below = 0, "Every client earned at least the " & FORMAT ( floor, "0%" ) & " margin floor.",
			        below <= 2, [Clients Below Floor Names] & IF ( below = 1, " is", " are" ) & " below the " & FORMAT ( floor, "0%" ) & " margin floor.",
			        below & " clients are below the " & FORMAT ( floor, "0%" ) & " margin floor. Lowest: " & [Lowest Margin Client] & "."
			    )
		displayFolder: Points

	/// The point for the row in context.
	measure 'Close Point Text' =
			SWITCH (
			    SELECTEDVALUE ( 'Close Point'[Point Order] ),
			    1, [Point Margin],
			    2, [Point Rates],
			    3, [Point Overheads],
			    4, [Point Missing Budget],
			    5, [Point Clients]
			)
		displayFolder: Points

	column 'Point Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Point Order

	column Topic
		dataType: string
		summarizeBy: none
		sourceColumn: Topic
		sortByColumn: 'Point Order'

	partition 'Close Point' = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [Point Order = Int64.Type, Topic = text],
				        {{1, "Margin"}, {2, "Billing rates"}, {3, "Overheads"}, {4, "Budget lines"}, {5, "Clients"}}
				    )
				in
				    Source

