relationship 'Ledger to Calendar'
	fromColumn: Ledger.'Month Key'
	toColumn: Calendar.'Month Key'

relationship 'Ledger to Service Line'
	fromColumn: Ledger.'Service Line'
	toColumn: 'Service Line'.'Service Line'

relationship 'Ledger to Account'
	fromColumn: Ledger.'Account Code'
	toColumn: Account.'Account Code'

relationship 'Ledger to Client'
	fromColumn: Ledger.Client
	toColumn: Client.Client

relationship 'Ledger to Entity'
	fromColumn: Ledger.'Entity Code'
	toColumn: Entity.'Entity Code'

relationship 'Capacity to Calendar'
	fromColumn: Capacity.'Month Key'
	toColumn: Calendar.'Month Key'

relationship 'Capacity to Service Line'
	fromColumn: Capacity.'Service Line'
	toColumn: 'Service Line'.'Service Line'
