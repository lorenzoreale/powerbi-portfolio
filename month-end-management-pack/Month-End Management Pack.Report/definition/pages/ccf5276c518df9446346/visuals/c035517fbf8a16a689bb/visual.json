  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What it is for",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Ashcombe Partners is a professional-services firm with four client-facing service lines: Advisory, Managed Services, Projects and Support. This pack is read at the monthly close by the finance director, the partners and the service-line heads.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#2A3A4D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "It answers the first question at every close: why is profit different from budget? It then shows where the difference came from, and what the meeting should look at.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#2A3A4D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "How to read it",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Start on Variance: two sentences, four figures, then the walk from budget to actual profit and the points for the meeting. Service lines shows the trends behind the month. P&L is the full statement, month and year to date. Clients shows who earns their margin.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#2A3A4D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Month at the top changes every page. Figures in brackets are costs, or variances that reduce profit. Red marks what is behind budget or below the margin floor.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1D2A36"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
    },
