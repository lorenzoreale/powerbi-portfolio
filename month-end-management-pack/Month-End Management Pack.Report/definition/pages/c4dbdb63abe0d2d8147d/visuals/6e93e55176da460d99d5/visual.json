                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Brick red marks an adverse variance, a client below the margin floor, a rate or margin more than a point under plan, or a check to review. Adverse amounts also carry brackets, so the pack reads the same in print.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
